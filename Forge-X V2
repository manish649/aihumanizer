 not None and x[\"first_hit\"] <= 6) else 0.0\nhit12 = lambda x: float(x[\"hit\"])\ntm = lambda p, fn: {i: sum(fn(x) for x in v) / len(v) for i, v in by[p].items()}\n\nrows = []\nfor p in pols:\n    allx = [x for v in by[p].values() for x in v]\n    hits = [x[\"first_hit\"] for x in allx if x[\"first_hit\"]]\n    rows.append({\"policy\": p, \"tasks\": len(by[p]), \"hit@6 calls\": round(sum(tm(p, hit6).values()) / max(1, len(by[p])), 3),\n                 \"hit@12 calls\": round(sum(tm(p, hit12).values()) / max(1, len(by[p])), 3),\n                 \"calls to hit\": round(sum(hits) / len(hits), 2) if hits else None,\n                 \"units shown\": round(sum(x[\"shown\"] for x in allx) / max(1, len(allx)), 1)})\nnav_df = pd.DataFrame(rows).set_index(\"policy\"); display(nav_df); nav_df.to_csv(CFG[\"OUT\"] / \"navigation_table.csv\")\n\nref6, ref12, out = tm(\"rank\", hit6), tm(\"rank\", hit12), []\nfor p in pols[1:]:\n    for nm, fn, ref in ((\"hit@12\", hit12, ref12), (\"hit@6\", hit6, ref6)):\n        cur = tm(p, fn); ids = sorted(set(cur) & set(ref)); d = [cur[i] - ref[i] for i in ids]\n        lo, hi = boot_ci(d)\n        out.append({\"policy\": p, \"metric\": nm, \"diff_vs_rank\": sum(d) / len(d), \"ci_lo\": lo, \"ci_hi\": hi, \"p\": signflip_p(d),\n                    \"wins\": sum(x > 0 for x in d), \"losses\": sum(x < 0 for x in d)})\nnav_delta = pd.DataFrame(out); nav_delta[\"holm_p\"] = holm(nav_delta[\"p\"].tolist())\ndisplay(nav_delta.round(3)); nav_delta.to_csv(CFG[\"OUT\"] / \"navigation_deltas.csv\", index=False)","metadata":{"execution":{"iopub.status.busy":"2026-10-17T01:49:22.144667Z","iopub.execute_input":"2026-10-17T01:49:22.144877Z","iopub.status.idle":"2026-10-17T01:49:27.332344Z","shell.execute_reply.started":"2026-10-17T01:49:22.14486Z","shell.execute_reply":"2026-10-17T01:49:27.331698Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"                        tasks  hit@6 calls  hit@12 calls  calls to hit  \\\n