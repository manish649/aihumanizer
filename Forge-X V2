gu, gf = gold_units(units, ch), gold_files(ch)\n    locs = {\"v2\": EvidenceLocalizer(units, files),\n            \"v1\": EvidenceLocalizer(units, files, doc_mode=\"v1\"),\n            \"v1t\": EvidenceLocalizer(units, files, exclude_tests=False, doc_mode=\"v1\")}\n    preps = {k: l.prepare(t[\"issue\"]) for k, l in locs.items()}\n    out = {\"instance_id\": t[\"instance_id\"], \"repo\": t[\"repo_id\"], \"n_gold_units\": len(gu), \"n_gold_files\": len(gf),\n           \"n_units\": len(locs[\"v2\"].units), \"graph\": locs[\"v2\"].graph_stats, \"rows\": {}, \"nav\": []}\n    for name, s in ALL_SYS.items():\n        l, p = locs[s[\"loc\"]], preps[s[\"loc\"]]\n        r = {}\n        if gu:\n            r.update({f\"unit/{a}\": b for a, b in rank_metrics(l.rank_units(p, **s[\"kw\"]), gu).items()})\n        if gf:\n            r.update({f\"file/{a}\": b for a, b in rank_metrics(l.rank_files(p, **s[\"kw\"]), gf, ks=(1, 3, 5)).items()})\n        out[\"rows\"][name] = r\n    if gu:                                   # navigation runs only where a gold unit exists\n        l, p = locs[\"v2\"], preps[\"v2\"]\n        sc, scg = l.unit_scores(p, **NAV_KW), l.unit_scores(p, **NAV_GRAPH_KW)\n        for pol in POLICIES:\n            for sd in (CFG[\"NAV_SEEDS\"] if pol == \"random_walk\" else [0]):\n                r = run_nav(NavEnv(l, sc, _ranked(sc), gu, CFG[\"NAV_BUDGET\"], CFG[\"NAV_K\"]), pol, sd)\n                out[\"nav\"].append({**r, \"instance_id\": t[\"instance_id\"], \"policy\": pol, \"seed\": sd, \"repo\": t[\"repo_id\"]})\n        r = run_nav(NavEnv(l, scg, _ranked(scg), gu, CFG[\"NAV_BUDGET\"], CFG[\"NAV_K\"]), \"rank\", 0)\n        out[\"nav\"].append({**r, \"instance_id\": t[\"instance_id\"], \"policy\": \"rank+graph\", \"seed\": 0, \"repo\": t[\"repo_id\"]})\n    return out\n\ncache_f = CFG[\"OUT\"] / \"phase1_rows.pkl\"\nEVAL = {r[\"instance_id\"]: r for r in pickle.load(open(cache_f, \"rb\"))} if cache_f.exists() else {}\nt0 = time.time()\nfor n, t in enumerate(tasks, 1):\n    if t[\"instance_id\"] in EVAL:\n        continue\n    try:\n        EVAL[t[\"instance_id\"]] = evaluate_task(t)\n    except Exception as e:\n        print(f\"{t['instance_id']}: skipped ({type(e).__name__}: {str(e)[:120]})\")\n    if n % 10 == 0:\n        print(f\"  {n}/{len(tasks)} tasks | {time.time() - t0:.0f}s\")\n        pickle.dump(list(EVAL.values()), open(cache_f, \"wb\"))\npickle.dump(list(EVAL.values()), open(cache_f, \"wb\"))\nRES = [EVAL[t[\"instance_id\"]] for t in tasks if t[\"instance_id\"] in EVAL]\nprint(f\"done: {len(RES)} tasks | with a gold unit: {sum(1 for r in RES if r['n_gold_units'])} | \"\n      f\"file-level only: {sum(1 for r in RES if not r['n_gold_units'] and r['n_gold_files'])} | {time.time() - t0:.0f}s\")\nimport statistics as st\ngl = [r[\"n_gold_units\"] for r in RES if r[\"n_gold_units\"]]\ng = [r[\"graph\"] for r in RES]\nprint(f\"gold units per task: median {st.median(gl)}, mean {st.mean(gl):.2f} (v1 labelling gave a mean of about 6.5)\")\nprint(f\"call edges resolved: {sum(x['resolved'] for x in g) / max(1, sum(x['calls'] for x in g)):.1%} | mean max degree {st.mean(x['max_degree'] for x in g):.0f}\")","metadata":{"execution":{"iopub.status.busy":"2026-10-17T01:43:49.824987Z","iopub.execute_input":"2026-10-17T01:43:49.825185Z","iopub.status.idle":"2026-10-17T01:49:13.318721Z","shell.execute_reply.started":"2026-10-17T01:43:49.825168Z","shell.execute_reply":"2026-10-17T01:49:13.318091Z"},"trusted":true},"outputs":[{"name":"stdout","text":"  10/129 tasks | 33s\n  20/129 tasks | 41s\n  30/129 tasks | 70s\n  40/129 tasks | 105s\n  50/129 tasks | 139s\n  60/129 tasks | 173s\n  70/129 tasks | 199s\n  80/129 tasks | 220s\n  90/129 tasks | 256s\n  100/129 tasks | 273s\n  110/129 tasks | 290s\n  120/129 tasks | 308s\ndone: 129 tasks | with a gold unit: 107 | file-level only: 22 | 323s\ngold units per task: median 1, mean 1.91 (v1 labelling gave a mean of about 6.5)\ncall edges resolved: 28.3% | mean max degree 90\n","o