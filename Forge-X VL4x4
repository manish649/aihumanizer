, \"is_test_path\", \"EvidenceLocalizer\", \"issue_identifiers\",\n           \"parse_changes\", \"gold_units\", \"gold_files\", \"rank_metrics\", \"mean_rows\", \"boot_ci\", \"signflip_p\",\n           \"holm\", \"paired\", \"clean_query\", \"split_title\", \"failure\", \"budget\", \"env\", \"NavEnv\", \"run_nav\", \"POLICIES\"]\n'''\n\nMODULES['tokens.py'] = r'''\"\"\"Shared identifier tokenizer (camelCase / snake_case aware).\"\"\"\nfrom __future__ import annotations\nimport re\n\n_WORD = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n\ndef tokenize(s: str):\n    out = []\n    for m in _WORD.finditer(s or \"\"):\n        w = re.sub(r\"([a-z0-9])([A-Z])\", r\"\\1 \\2\", m.group(0))\n        for t in w.replace(\"_\", \" \").split():\n            t = t.lower()\n            if t:\n                out.append(t)\n    return out\n'''\n\nMODULES['ast_index.py'] = r'''\"\"\"AST index v2: unique unit ids (path::qualname), per-file import maps, scoped call records.\"\"\"\nfrom __future__ import annotations\nimport ast\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\nSKIP_DIRS = {\".git\", \".hg\", \".svn\", \"node_modules\", \"site-packages\", \".venv\", \"venv\", \"env\",\n             \"__pycache__\", \"build\", \"dist\", \".tox\", \".mypy_cache\", \".pytest_cache\", \".eggs\"}\nTEST_DIRS = {\"tests\", \"test\", \"testing\"}\n\n\ndef is_test_path(p: str) -> bool:\n    parts = p.replace(\"\\\\\", \"/\").lower().split(\"/\")\n    name = parts[-1]\n    return (any(x in TEST_DIRS for x in parts[:-1]) or name.startswith(\"test_\")\n            or name.endswith(\"_test.py\") or name == \"conftest.py\")\n\n\n@dataclass\nclass Unit:\n    uid: str\n    name: str\n    qualname: str\n    kind: str                # \"function\" | \"class\"\n    path: str\n    start: int\n    end: int\n    indent: int              # column of the def/class keyword\n    text: str\n    doc: str = \"\"\n    calls: list = field(default_factory=list)    # [(mode, name)] mode: name | self | attr\n    bases: list = field(default_factory=list)\n    parent: str | None = None                    # uid of the enclosing unit\n    is_test: bool = False\n\n\n@dataclass\nclass FileInfo:\n    path: str\n    module: str\n    is_pkg: bool\n    imports: dict = field(default_factory=dict)  # local name -> (dotted module, symbol | None)\n    n_lines: int = 0\n\n\ndef _calls(node):\n    out = set()\n    for c in ast.walk(node):\n        if isinstance(c, ast.Call):\n            f = c.func\n            if isinstance(f, ast.Name):\n                out.add((\"name\", f.id))\n            elif isinstance(f, ast.Attribute):\n                if isinstance(f.value, ast.Name) and f.value.id in (\"self\", \"cls\"):\n                    out.add((\"self\", f.attr))\n                else:\n                    out.add((\"attr\", f.attr))\n    return sorted(out)\n\n\ndef _base_name(b):\n    if isinstance(b, ast.Name):\n        return b.id\n    if isinstance(b, ast.Attribute):\n        return b.attr\n    return None\n\n\nclass _Visitor(ast.NodeVisitor):\n    def __init__(self, path, lines, test):\n        self.path, self.lines, self.test = path, lines, test\n        self.units, self.stack = [], []          # stack of (name, uid)\n\n    def _text(self, node):\n        return \"\\n\".join(self.lines[node.lineno - 1:getattr(node, \"end_lineno\", node.lineno)])\n\n    def _add(self, node, kind, calls, bases):\n        q = \".\".join([n for n, _ in self.stack] + [node.name])\n        uid = f\"{self.path}::{q}\"\n        doc = ast.get_docstring(node) or \"\"\n        start = min([node.lineno] + [d.lineno for d in getattr(node, \"decorator_list\", [])])\n        self.units.append(Unit(uid, node.name, q, kind, self.path, start,\n                               getattr(node, \"end_lineno\", node.lineno), node.col_offset, self._text(node),\n                               doc, calls, bases, self.stack[-1][1] if self.stack else None, self.test))\n        self.stack.append((node.name, uid))\n        self.generic_visit(node)\n        self.stack.pop()\n\n    def visit_FunctionDef(self, node):\n        self._add(node, \"function\", _calls(node), [])\n\n    visit_AsyncFunctionDef = visit_FunctionDef\n\n    def visit_ClassDef(self, node):\n        self._add(node, \"class\", [], [b for b in (_base_name(x) for x in node.bases) if b])\n\n\ndef _module_name(rel):\n    parts = rel[:-3].split(\"/\")\n    is_pkg = parts[-1] == \"__init__\"\n    if is_pkg:\n        parts = parts[:-1]\n    return \".\".join(parts), is_pkg\n\n\ndef _imports(tree, module, is_pkg):\n    imps = {}\n    pkg = module if is_pkg else module.rpartition(\".\")[0]\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Import):\n            for a in n.names:\n                imps[a.asname or a.name.split(\".\")[0]] = (a.name if a.asname else a.name.split(\".\")[0], None)\n        elif isinstance(n, ast.ImportFrom):\n            base = n.module or \"\"\n            if n.level:\n                up = pkg.split(\".\") if pkg else []\n                up = up[:len(up) - (n.level - 1)] if n.level > 1 else up\n                base = \".\".join([x for x in up + ([n.module] if n.module else []) if x])\n            for a in n.names:\n                if a.name != \"*\":\n                    imps[a.asname or a.name] = (base, a.name)\n    return imps\n\n\ndef index_repo(root):\n    root = Path(root)\n    units, files = [], {}\n    for p in sorted(root.rglob(\"*.py\")):\n        rel = p.relative_to(root).as_posix()\n        if set(rel.split(\"/\")) & SKIP_DIRS:\n            continue\n        try:\n            src = p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n            tree = ast.parse(src)\n        except Exception:\n            continue\n        mod, is_pkg = _module_name(rel)\n        files[rel] = FileInfo(rel, mod, is_pkg, _imports(tree, mod, is_pkg), src.count(\"\\n\") + 1)\n        v = _Visitor(rel, src.splitlines(), is_test_path(rel))\n        v.visit(tree)\n        units.extend(v.units)\n    return units, files\n'''\n\nMODULES['bm25.py'] = r'''\"\"\"Minimal BM25 over code units.\"\"\"\nfrom __future__ import annotations\nimport math\nfrom collections import Counter\nfrom .tokens import tokenize\n\nclass BM25:\n    def __init__(self, docs, k1=1.5, b=0.75):\n        self.k1, self.b = k1, b\n        self.docs = [tokenize(d) for d in docs]\n        self.N = len(self.docs)\n        self.avgdl = (sum(len(d) for d in self.docs) / self.N) if self.N else 0.0\n        self.tf = [Counter(d) for d in self.docs]\n        df = Counter()\n        for d in self.docs:\n            df.update(set(d))\n        self.idf = {w: math.log(1 + (self.N - c + 0.5) / (c + 0.5)) for w, c in df.items()}\n\n    def scores(self, query):\n        qt = tokenize(query)\n        out = []\n        for i, cf in enumerate(self.tf):\n            dl = len(self.docs[i]) or 1\n            s = 0.0\n            for w in qt:\n                f = cf.get(w, 0)\n                if not f:\n                    continue\n                idf = self.idf.get(w, 0.0)\n                s += idf * f * (self.k1 + 1) / (f + self.k1 * (1 - self.b + self.b * dl / self.avgdl))\n            out.append(s)\n        return out\n'''\n\nMODULES['similarity.py'] = r'''\"\"\"TF-IDF cosine similarity, plus an explicit hashed-embedding fallback.\"\"\"\nfrom __future__ import annotations\nimport math\nfrom collections import Counter\nfrom .tokens import tokenize\n\nclass TfidfCosine:\n    def __init__(self, docs):\n        self.docs = [tokenize(d) for d in docs]\n        df = Counter()\n        for d in self.docs:\n            df.update(set(d))\n        n = len(self.docs) or 1\n        self.idf = {w: math.log((1 + n) / (1 + c)) + 1 for w, c in df.items()}\n        self.default_idf = math.log(1 + n) + 1\n        self.vec = [self._v(d) for d in self.docs]\n\n    def _v(self, toks):\n        tf = Counter(toks)\n        v = {w: tf[w] * self.idf.get(w, self.default_idf) for w in tf}\n        norm = math.sqrt(sum(x * x for x in v.values())) or 1.0\n        return {w: x / norm for w, x in v.items()}\n\n    def scores(self, query):\n        qv = self._v(tokenize(query))\n        out = []\n        for v in self.vec:\n            a, b = (v, qv) if len(v) < len(qv) else (qv, v)\n            out.append(sum(x * b.get(w, 0.0) for w, x in a.items()))\n        return out\n\ndef hash_embed(text, dim=256):\n    \"\"\"Deterministic hashed bag-of-identifiers embedding. NOT a learned embedding; used only\n    when the harness's 256-d embeddings are unavailable, and always labelled as such.\"\"\"\n    v = [0.0] * dim\n    for t in tokenize(text):\n        v[hash(t) % dim] += 1.0\n    norm = math.sqrt(sum(x * x for x in v)) or 1.0\n    return [x / norm for x in v]\n\ndef cosine(a, b):\n    return sum(x * y for x, y in zip(a, b))\n'''\n\nMODULES['graphprop.py'] = r'''\"\"\"Scoped call-graph construction (v2) and seed-restricted evidence propagation.\n\nv1 linked a call to EVERY unit sharing its bare name (get, update, __init__ ...), merged units with equal\nqualnames across files, and diffused mass over all nodes. That makes hubs and wrecks the ranking. Here an edge is\ncreated only when the target can be resolved with some confidence:\n  self.x()   -> method x of the enclosing class (or its resolvable bases)\n  x()        -> x in the same file, else the symbol imported under that name, else a repo-unique x\n  obj.x()    -> only if exactly one non-test unit is called x repo-wide\n\"\"\"\nfrom __future__ import annotations\nimport math\nfrom collections import defaultdict\n\n\ndef _enclosing_class(u, by_uid):\n    p = u.parent\n    while p:\n        pu = by_uid.get(p)\n        if pu is None:\n            return None\n        if pu.kind == \"class\":\n            return pu\n        p = pu.parent\n    return None\n\n\ndef build_edges(units, files):\n    \"\"\"Return (adj, stats). adj: uid -> set(uid), undirected, test units excluded.\"\"\"\n    src = [u for u in units if not u.is_test]\n    by_uid = {u.uid: u for u in src}\n    by_file = defaultdict(lambda: defaultdict(list))      # path -> name -> [uid] (any depth)\n    methods = defaultdict(dict)                           # class uid -> {name: uid}\n    glob = defaultdict(list)                              # name -> [uid]\n    classes = defaultdict(list)                           # class name -> [uid]\n    for u in src:\n        by_file[u.path][u.name].append(u.uid)\n        if not u.name.startswith(\"__\"):\n            glob[u.name].append(u.uid)\n        if u.parent and by_uid.get(u.parent) is not None and by_uid[u.parent].kind == \"class\":\n            methods[u.parent][u.name] = u.uid\n        if u.kind == \"class\":\n            classes[u.name].append(u.uid)\n    mod_to_path = {}\n    for path, fi in files.items():\n        mod_to_path.setdefault(fi.module, path)\n        parts = fi.module.split(\".\")\n        if len(parts) > 1 and parts[0] in (\"src\", \"lib\"):\n            mod_to_path.setdefault(\".\".join(parts[1:]), path)\n\n    def method_lookup(cls, name, depth=0):\n        if name in methods.get(cls.uid, {}):\n            return methods[cls.uid][name]\n        if depth >= 3:\n            return None\n        for b in cls.bases:\n            cands = [c for c in classes.get(b, []) if by_uid[c].path == cls.path] or \\\n                    (classes.get(b, []) if len(classes.get(b, [])) == 1 else [])\n            for c in cands:\n                r = method_lookup(by_uid[c], name, depth + 1)\n                if r:\n                    return r\n        return None\n\n    adj, n_resolved, n_calls = defaultdict(set), 0, 0\n    for u in src:\n        fi = files.get(u.path)\n        for mode, name in u.calls:\n            n_calls += 1\n            tgt = None\n            if mode == \"self\":\n                cls = _enclosing_class(u, by_uid)\n                tgt = method_lookup(cls, name) if cls else None\n            elif mode == \"name\":\n                same = by_file[u.path].get(name, [])\n                if len(same) >= 1:\n                    tgt = next((s for s in same if s != u.uid), None)\n                elif fi and name in fi.imports:\n                    mod, sym = fi.imports[name]\n                    p = mod_to_path.get(mod)\n                    cand = by_file[p].get(sym or name, []) if p else []\n                    tgt = cand[0] if len(cand) == 1 else None\n                if tgt is None and len(glob.get(name, [])) == 1:\n                    tgt = glob[name][0]\n            else:\n                if len(glob.get(name, [])) == 1:\n                    tgt = glob[name][0]\n            if tgt and tgt != u.uid:\n                adj[u.uid].add(tgt)\n                adj[tgt].add(u.uid)\n                n_resolved += 1\n    return adj, {\"calls\": n_calls, \"resolved\": n_resolved,\n                 \"max_degree\": max((len(v) for v in adj.values()), default=0)}\n\n\ndef propagate_bonus(base, adj, seeds_k=10, steps=1, hub_cap=25):\n    \"\"\"Bonus for neighbours of the top-K seeds, damped by 1/sqrt(degree). base: dict uid -> score.\"\"\"\n    top = sorted(base, key=base.get, reverse=True)[:seeds_k]\n    bonus = defaultdict(float)\n    frontier = {s: base[s] for s in top if base[s] > 0}\n    for _ in range(max(1, steps)):\n        nxt = defaultdict(float)\n        for n, s in frontier.items():\n            nb = adj.get(n, ())\n            if not nb or len(nb) > hub_cap:\n                continue\n            contribution = s / math.sqrt(len(nb))\n            for neighbor in nb:\n                if neighbor in base and base[neighbor] > 0:\n                    continue\n                bonus[neighbor] += contribution\n                nxt[neighbor] += contribution\n        frontier = nxt\n    return dict(bonus)\n\n'''\n\nMODULES['gold.py'] = r'''\"\"\"Gold-unit labelling: parse a unified diff into changed lines and map them to the innermost code units.\"\"\"\nfrom __future__ import annotations\nimport re\n\n\n_HUNK = re.compile(r\"^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\")\n\n\ndef parse_changes(patch):\n    \"\"\"{path: {\"rem\": set(old line numbers), \"ins\": [(anchor_old_line, min_indent|None)], \"new\": bool}}\"\"\"\n    files, cur, old_ln, block = {}, None, None, []\n\n    def flush():\n        nonlocal block\n        if cur is not None and block:\n            ind = [i for i in block if i is not None]\n            files[cur][\"ins\"].append((old_ln, min(ind) if ind else None))\n        block = []\n\n    for line in (patch or \"\").splitlines():\n        if line.startswith(\"diff --git\"):\n            flush(); cur, old_ln = None, None\n        elif line.startswith(\"--- \") and old_ln is None:\n            continue\n        elif line.startswith(\"+++ \") and old_ln is None:\n            p = line[4:].strip()\n            p = p[2:] if p.startswith(\"b/\") else p\n            cur = None if p == \"/dev/null\" else p\n            if cur:\n                files.setdefault(cur, {\"rem\": set(), \"ins\": [], \"new\": False})\n        elif line.startswith(\"@@\"):\n            flush()\n            m = _HUNK.match(line)\n            if m and cur:\n                old_ln = int(m.group(1))\n                if int(m.group(2) or 1) == 0 and old_ln == 0:\n                    files[cur][\"new\"] = True\n        elif cur is not None and old_ln is not None:\n            if line.startswith(\"+\"):\n                body = line[1:]\n                block.append(len(body) - len(body.lstrip()) if body.strip() else None)\n            elif line.startswith(\"-\"):\n                flush(); files[cur][\"rem\"].add(old_ln); old_ln += 1\n            elif line.startswith(\"\\\\\"):\n                continue\n            else:\n                flush(); old_ln += 1\n    flush()\n    return files\n\n\ndef _innermost(spans, ln):\n    best = None\n    for u in spans:\n        if u.start <= ln <= u.end and (best is None or (u.end - u.start) < (best.end - best.start)):\n            best = u\n    return best\n\n\ndef _ancestors(uid, by_uid):\n    out = []\n    while uid in by_uid:\n        out.append(uid)\n        uid = by_uid[uid].parent\n    return out\n\n\ndef gold_units(units, changes):\n    \"\"\"Set of unit uids touched by the change (innermost unit per changed line / inserted block).\"\"\"\n    by_path, by_uid = {}, {u.uid: u for u in units}\n    for u in units:\n        by_path.setdefault(u.path, []).append(u)\n    out = set()\n    for path, ch in changes.items():\n        spans = by_path.get(path)\n        if not spans or ch[\"new\"]:\n            continue\n        for ln in ch[\"rem\"]:\n            u = _innermost(spans, ln)\n            if u:\n                out.add(u.uid)\n        for anchor, indent in ch[\"ins\"]:\n            if indent is None:\n                continue\n            c1, c2 = _innermost(spans, anchor - 1), _innermost(spans, anchor)\n            if c1 is c2:\n                u = c1 if indent > 0 else None\n            elif c1 is not None and indent > c1.indent:\n                u = c1                                            # block is deeper than c1's def line: body of c1\n            elif c1 is not None and c2 is not None:\n                a2 = set(_ancestors(c2.uid, by_uid))\n                u = next((by_uid[a] for a in _ancestors(c1.uid, by_uid) if a in a2), None)\n            else:\n                u = (c1 or c2) if indent > 0 else None\n            if u:\n                out.add(u.uid)\n    return out\n\n\ndef gold_files(changes):\n    return {p for p in changes if p.endswith(\".py\")}\n'''\n\nMODULES['metrics.py'] = r'''\"\"\"Ranking metrics, bootstrap intervals and paired comparisons.\"\"\"\nfrom __future__ import annotations\nimport random\n\n\ndef rank_metrics(order, gold, ks=(1, 3, 5, 10)):\n    gold = set(gold or [])\n    m = {f\"acc@{k}\": 1.0 if (gold & set(order[:k])) else 0.0 for k in ks}\n    m[\"mrr\"] = 0.0\n    for i, n in enumerate(order, 1):\n        if n in gold:\n            m[\"mrr\"] = 1.0 / i\n            break\n    m[\"recall@5\"] = len(gold & set(order[:5])) / len(gold) if gold else 0.0\n    return m\n\n\ndef mean_rows(rows, keys):\n    out = {}\n    for k in keys:\n        vals = [r[k] for r in rows if k in r]\n        out[k] = sum(vals) / len(vals) if vals else 0.0\n    return out\n\n\ndef boot_ci(vals, n=4000, seed=7):\n    vals = list(vals)\n    if not vals:\n        return (float(\"nan\"), float(\"nan\"))\n    rng, m = random.Random(seed), len(vals)\n    bs = sorted(sum(vals[rng.randrange(m)] for _ in range(m)) / m for _ in range(n))\n    return bs[int(0.025 * n)], bs[int(0.975 * n) - 1]\n\n\ndef signflip_p(d, n=20000, seed=11):\n    d = [x for x in d]\n    if not d:\n        return float(\"nan\")\n    rng, obs = random.Random(seed), abs(sum(d))\n    hits = sum(abs(sum(x if rng.random() < 0.5 else -x for x in d)) >= obs - 1e-12 for _ in range(n))\n    return (hits + 1) / (n + 1)\n\n\ndef holm(pvals):\n    order = sorted(range(len(pvals)), key=lambda i: pvals[i])\n    adj, run = [0.0] * len(pvals), 0.0\n    for rank, i in enumerate(order):\n        run = max(run, (len(pvals) - rank) * pvals[i])\n        adj[i] = min(1.0, run)\n    return adj\n\n\ndef paired(rows_a, rows_b, key):\n    a = {r[\"instance_id\"]: r[key] for r in rows_a if key in r}\n    b = {r[\"instance_id\"]: r[key] for r in rows_b if key in r}\n    ids = sorted(set(a) & set(b))\n    d = [b[i] - a[i] for i in ids]\n    if not d:\n        return None\n    lo, hi = boot_ci(d)\n    return {\"n\": len(d), \"mean_diff\": sum(d) / len(d), \"ci95\": (lo, hi), \"p\": signflip_p(d),\n            \"wins\": sum(x > 0 for x in d), \"losses\": sum(x < 0 for x in d)}\n'''\n\nMODULES['localize.py'] = r'''\"\"\"Contribution A (v2): evidence-weighted localization over unique code units.\n\nEvidence: BM25 over unit documents, exact identifier / path signals taken from the issue, optional TF-IDF\nsimilarity, and a small, seed-restricted graph bonus. Test code is excluded from the candidates (gold patches\nexclude tests). prepare() computes the expensive parts once so knobs can be swept cheaply.\"\"\"\nfrom __future__ import annotations\nimport re\nfrom collections import defaultdict\nfrom .bm25 import BM25\nfrom .similarity import TfidfCosine\nfrom .graphprop import build_edges, propagate_bonus\nfrom .tokens import tokenize\n\n_ID = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n_PATH = re.compile(r\"([\\w/\\.\\-]+\\.py)\")\n\n\ndef _norm(v):\n    hi = max(v) if v else 0.0\n    return [x / hi for x in v] if hi > 0 else [0.0] * len(v)\n\n\ndef issue_identifiers(issue):\n    ids = set()\n    for m in re.finditer(r\"`([^`\\n]+)`\", issue or \"\"):\n        ids.update(_ID.findall(m.group(1)))\n    for t in _ID.findall(issue or \"\"):\n        if (\"_\" in t.strip(\"_\")) or re.search(r\"[a-z][A-Z]\", t):\n            ids.add(t)\n    return {i for i in ids if len(i) > 2}\n\n\nclass EvidenceLocalizer:\n    def __init__(self, units, files, exclude_tests=True, doc_mode=\"v2\"):\n        self.units = [u for u in units if not (exclude_tests and u.is_test)]\n        self.by_uid = {u.uid: u for u in self.units}\n        kids = defaultdict(list)\n        for u in self.units:\n            if u.parent:\n                kids[u.parent].append(u.name)\n\n        def doc(u):\n            if doc_mode == \"v1\" or u.kind != \"class\":\n                return f\"{u.name} {u.qualname} {u.doc} {u.text}\" if doc_mode != \"v1\" else f\"{u.name} {u.qualname} {u.text}\"\n            return f\"{u.name} {u.qualname} {u.doc} \" + \" \".join(kids.get(u.uid, []))   # class: header, not all bodies\n\n        docs = [doc(u) for u in self.units]\n        self.bm25 = BM25(docs)\n        self.name_bm25 = BM25([f\"{u.name} {u.qualname} {u.path}\" for u in self.units])\n        self._tfidf = None\n        self._docs = docs\n        self.adj, self.graph_stats = build_edges(units, files)\n        self.files = files\n\n    def tfidf(self):\n        if self._tfidf is None:\n            self._tfidf = TfidfCosine(self._docs)\n        return self._tfidf\n\n    def neighbors(self, uid):\n        return sorted(self.adj.get(uid, ()))\n\n    def degree(self, uid):\n        return len(self.adj.get(uid, ()))\n\n    def prepare(self, query):\n        ids, paths = issue_identifiers(query), set(_PATH.findall(query or \"\"))\n        sig = []\n        for u in self.units:\n            s = 0.0\n            if u.name in ids:\n                s += 1.0\n            parts = u.qualname.split(\".\")\n            if any(p in ids for p in parts[:-1]):\n                s += 0.5\n            if any(u.path == p or u.path.endswith(\"/\" + p) or u.path.endswith(p) for p in paths):\n                s += 1.0\n            sig.append(s)\n        return {\"lex\": _norm(self.bm25.scores(query)), \"name\": _norm(self.name_bm25.scores(query)),\n                \"sig\": _norm(sig), \"sim\": None, \"query\": query}\n\n    def unit_scores(self, prep, w_lex=1.0, w_name=0.3, w_sig=0.5, w_sim=0.0, beta=0.0, K=10, steps=1):\n        if w_sim and prep[\"sim\"] is None:\n            prep[\"sim\"] = _norm(self.tfidf().scores(prep[\"query\"]))\n        sim = prep[\"sim\"] or [0.0] * len(self.units)\n        base = {u.uid: w_lex * prep[\"lex\"][i] + w_name * prep[\"name\"][i] + w_sig * prep[\"sig\"][i] + w_sim * sim[i]\n                for i, u in enumerate(self.units)}\n        if beta > 0:\n            bonus = propagate_bonus(base, self.adj, seeds_k=K, steps=steps)\n            hi = max(bonus.values(), default=0.0)\n            if hi > 0:\n                top = max(base.values()) or 1.0\n                for k, v in bonus.items():\n                    if k in base:\n                        base[k] += beta * top * (v / hi)\n        return base\n\n    def rank_units(self, prep, **kw):\n        if isinstance(prep, str):\n            prep = self.prepare(prep)\n        sc = self.unit_scores(prep, **kw)\n        return [k for k, _ in sorted(sc.items(), key=lambda kv: (-kv[1], kv[0]))]\n\n    def rank_files(self, prep, file_mix=0.0, **kw):\n        if isinstance(prep, str):\n            prep = self.prepare(prep)\n        sc = self.unit_scores(prep, **kw)\n        per = defaultdict(list)\n        for uid, s in sc.items():\n            per[self.by_uid[uid].path].append(s)\n        fs = {p: max(v) + file_mix * sum(sorted(v, reverse=True)[1:3]) for p, v in per.items()}\n        return [p for p, _ in sorted(fs.items(), key=lambda kv: (-kv[1], kv[0]))]\n'''\n\nMODULES['query.py'] = r'''\"\"\"Query preparation (v3). The task statements are pull-request descriptions (title + body), and many bodies carry\ntemplate boilerplate: HTML comments, checklists ('- [x] I've added tests'), headings, AI-disclaimer blocks. Those words\n('tests', 'documentation', 'coverage', 'black', 'changelog') match test and docs code and add noise to lexical retrieval.\"\"\"\nfrom __future__ import annotations\nimport re\n\n_HTML_COMMENT = re.compile(r\"<!--.*?-->\", re.S)\n_TAGS = re.compile(r\"</?(details|summary|br|p|img|a)[^>]*>\", re.I)\n_CHECK = re.compile(r\"^\\s*[-*+]\\s*\\[[ xX]\\]\")\n_HEADING = re.compile(r\"^\\s*#{1,6}\\s*(.*?)\\s*:?\\s*$\")\n_HEAD_WORDS = {\"pull request\", \"description\", \"checklist\", \"ai disclaimer\", \"type of changes\", \"type of change\",\n               \"summary\", \"changes\", \"testing\", \"motivation\", \"related issues\", \"what\", \"why\", \"notes\", \"note\",\n               \"ai transcript\", \"details\", \"context\", \"background\"}\n_URL = re.compile(r\"https?://\\S+\")\n_ISSUE_REF = re.compile(r\"(?<![\\w/])#\\d+\\b|\\bGH-\\d+\\b\", re.I)\n_RULE = re.compile(r\"^\\s*(-{3,}|\\*{3,}|_{3,}|`{3}\\w*)\\s*$\")\n\n\ndef split_title(text):\n    lines = (text or \"\").strip().splitlines()\n    return (lines[0].strip(), \"\\n\".join(lines[1:])) if lines else (\"\", \"\")\n\n\ndef clean_query(text, title_weight=1):\n    \"\"\"Return the statement without template boilerplate; the title is repeated title_weight times in total.\"\"\"\n    title, body = split_title(text)\n    body = _HTML_COMMENT.sub(\" \", body)\n    body = _TAGS.sub(\" \", body)\n    keep = []\n    for ln in body.splitlines():\n        if _CHECK.match(ln) or _RULE.match(ln):\n            continue\n        m = _HEADING.match(ln)\n        if m and m.group(1).lower() in _HEAD_WORDS:\n            continue\n        keep.append(ln)\n    body = _ISSUE_REF.sub(\" \", _URL.sub(\" \", \"\\n\".join(keep)))\n    title = _ISSUE_REF.sub(\" \", _URL.sub(\" \", title))\n    body = re.sub(r\"[ \\t]+\", \" \", body)\n    body = re.sub(r\"\\n\\s*\\n+\", \"\\n\", body).strip()\n    return \"\\n\".join([title] * max(1, title_weight) + ([body] if body else []))\n'''\n\nMODULES['failure.py'] = r'''\"\"\"Contribution B: failure-conditioned repair.\n\nClassify why a repair attempt failed and pick a different next action instead of\nrepeating the same strategy.\n\"\"\"\nfrom __future__ import annotations\nimport re\nfrom dataclasses import dataclass, field\n\nFAILURE_CLASSES = (\"localization_error\", \"implementation_error\", \"regression\",\n                   \"incomplete_verification\", \"unknown\")\n\nNEXT_ACTION = {\n    \"localization_error\": {\"tool\": \"get_code_neighbors\",\n                           \"why\": \"expand the graph around the failing test's callers\"},\n    \"implementation_error\": {\"tool\": \"edit_file\",\n                             \"why\": \"re-read the edited unit and change the logic again\"},\n    \"regression\": {\"tool\": \"run_command\",\n                   \"why\": \"inspect and revert the change that broke passing tests\"},\n    \"incomplete_verification\": {\"tool\": \"run_command\",\n                                \"why\": \"run the failing tests to observe real behaviour\"},\n    \"unknown\": {\"tool\": \"get_code_subgraph\",\n                \"why\": \"gather more context before committing to a strategy\"},\n}\n\n_FAIL_LINE = re.compile(r\"(?:FAILED|ERROR)[^\\n]*?([\\w/\\.\\-]+\\.py)\")\n\n@dataclass\nclass Step:\n    action: str\n    args: dict = field(default_factory=dict)\n    ok: bool = True\n    stdout: str = \"\"\n    stderr: str = \"\"\n    tests_run: int = 0\n    tests_passed: int = 0\n    tests_failed: int = 0\n    new_failures: list = field(default_factory=list)\n    changed_files: list = field(default_factory=list)\n\ndef _touched(trace):\n    t = set()\n    for s in trace:\n        t |= set(s.changed_files or [])\n    return t\n\ndef classify_failure(trace):\n    ran = [s for s in trace if (s.tests_run or \"pytest\" in (s.stdout + s.stderr))]\n    if not ran:\n        return {\"label\": \"incomplete_verification\", \"confidence\": 0.5,\n                \"rationale\": \"no test run observed in the trace\"}\n    last = ran[-1]\n    if last.new_failures:\n        return {\"label\": \"regression\", \"confidence\": 0.8,\n                \"rationale\": f\"previously passing tests now fail: {last.new_failures[:3]}\"}\n    fail_files = set(_FAIL_LINE.findall(last.stdout + last.stderr))\n    touched = _touched(trace)\n    if last.tests_failed and fail_files and not (fail_files & touched):\n        return {\"label\": \"localization_error\", \"confidence\": 0.6,\n                \"rationale\": f\"failing tests {sorted(fail_files)[:2]} were never edited\"}\n    if last.tests_failed:\n        return {\"label\": \"implementation_error\", \"confidence\": 0.7,\n                \"rationale\": f\"{last.tests_failed} test(s) still fail after editing\"}\n    if last.tests_failed == 0 and last.tests_run:\n        return {\"label\": \"incomplete_verification\", \"confidence\": 0.3,\n                \"rationale\": \"observed tests pass; confirm the issue's own scenario\"}\n    return {\"label\": \"unknown\", \"confidence\": 0.2, \"rationale\": \"insufficient signal\"}\n\ndef next_action_for(trace):\n    c = classify_failure(trace)\n    c[\"next_action\"] = NEXT_ACTION[c[\"label\"]]\n    return c\n'''\n\nMODULES['budget.py'] = r'''\"\"\"Contribution C: budget-aware action selection by expected information gain.\"\"\"\nfrom __future__ import annotations\n\nCOST = {\"search_similar_code\": 1.0, \"get_code_neighbors\": 1.0, \"get_code_subgraph\": 1.5}\nSTOP_THRESHOLD = 0.05\n\ndef _components_bonus(action, comps):\n    if action != \"get_code_subgraph\" or comps < 2:\n        return 0.0\n    return min(1.0, (comps - 1) / 2.0)\n\ndef score_action(cand):\n    action = cand.get(\"action\", \"\")\n    cost = COST.get(action, 2.0)\n    novelty = float(cand.get(\"novelty\", 0.0))\n    relevance = float(cand.get(\"relevance\", 0.0))\n    centrality = float(cand.get(\"centrality\", 0.0))\n    comps = float(cand.get(\"components\", 0.0))\n    if novelty <= 0.0:\n        return 0.0\n    gain = novelty * (0.6 * relevance + 0.4 * centrality)\n    gain += 0.3 * _components_bonus(action, comps)\n    return gain / cost\n\ndef score_actions(state):\n    scored = [{**c, \"score\": round(score_action(c), 4)} for c in state.get(\"candidates\", [])]\n    scored.sort(key=lambda c: c[\"score\"], reverse=True)\n    return scored\n\ndef decide(state):\n    ranked = score_actions(state)\n    if not ranked or ranked[0][\"score\"] < STOP_THRESHOLD:\n        return {\"stop\": True, \"reason\": \"marginal gain below threshold\", \"ranked\": ranked}\n    best = ranked[0]\n    return {\"stop\": False, \"action\": best[\"action\"], \"args\": best[\"args\"],\n            \"score\": best[\"score\"], \"ranked\": ranked}\n'''\n\nMODULES['env.py'] = r'''\"\"\"Navigation environment v2 (measures Contribution C without an LLM) with a FAIR cost model.\n\nv1 problems: every call to the 'lexical' policy used the graph-propagated ranking (prop_w=1.0 by default), and\nget_code_subgraph revealed an unbounded number of units, so policies were compared at different context costs.\nHere every action reveals at most k new units, 'rank' is the plain ranking read k at a time, and all policies use the\nsame base scores for relevance.\"\"\"\nfrom __future__ import annotations\nimport random\nfrom . import budget\n\n\nclass NavEnv:\n    def __init__(self, loc, scores, order, gold, budget_calls=12, k=5):\n        self.loc, self.sc, self.order = loc, scores, order\n        hi = max(scores.values(), default=0.0) or 1.0\n        self.n = {u: s / hi for u, s in scores.items()}\n        self.gold, self.budget, self.k = set(gold or []), budget_calls, k\n        self.maxdeg = max([len(v) for v in loc.adj.values()] + [1])\n        self.visited, self.seq, self.calls, self.first_hit, self.expanded = set(), [], 0, None, set()\n\n    def unseen_top(self):\n        return [u for u in self.order if u not in self.visited][:self.k]\n\n    def nbrs(self, node):\n        nb = [m for m in self.loc.neighbors(node) if m not in self.visited and m in self.n]\n        return sorted(nb, key=lambda m: (-self.n[m], m))[:self.k]\n\n    def pooled(self):\n        pool = set()\n        for v in self.visited:\n            pool |= {m for m in self.loc.neighbors(v) if m not in self.visited and m in self.n}\n        return sorted(pool, key=lambda m: (-self.n[m], m))[:self.k]\n\n    def act(self, action, node=None):\n        self.calls += 1\n        if action == \"search_similar_code\":\n            new = self.unseen_top()\n        elif action == \"get_code_neighbors\":\n            new = self.nbrs(node)\n            self.expanded.add(node)\n        else:\n            new = self.pooled()\n        for u in new:\n            self.visited.add(u)\n            self.seq.append(u)\n        if self.first_hit is None and (self.gold & self.visited):\n            self.first_hit = self.calls\n        return new\n\n    def done(self):\n        return self.calls >= self.budget or bool(self.gold & self.visited)\n\n    def result(self):\n        return {\"hit\": int(bool(self.gold & self.visited)), \"first_hit\": self.first_hit, \"calls\": self.calls,\n                \"shown\": len(self.visited)}\n\n\ndef pol_rank(env, rng=None):\n    return (\"search_similar_code\", None)\n\n\ndef pol_random(env, rng):\n    if not env.visited:\n        return (\"search_similar_code\", None)\n    return (\"get_code_neighbors\", rng.choice(sorted(env.visited)))\n\n\ndef pol_graph_bfs(env, rng=None):\n    if not env.visited:\n        return (\"search_similar_code\", None)\n    best, bn = None, 0\n    for n in sorted(env.visited):\n        c = sum(1 for m in env.loc.neighbors(n) if m not in env.visited and m in env.n)\n        if c > bn:\n            best, bn = n, c\n    return (\"get_code_neighbors\", best) if best else (\"search_similar_code\", None)\n\n\ndef pol_best_first(env, rng=None):\n    \"\"\"Greedy: expand the highest-scoring visited node that still has unseen neighbours, else read more ranking.\"\"\"\n    if not env.visited:\n        return (\"search_similar_code\", None)\n    for n in sorted(env.visited, key=lambda x: (-env.n.get(x, 0.0), x)):\n        if n not in env.expanded and env.nbrs(n):\n            return (\"get_code_neighbors\", n)\n    return (\"search_similar_code\", None)\n\n\ndef _infogain(env, use_centrality):\n    if not env.visited:\n        return (\"search_similar_code\", None)\n    cands = []\n    top = env.unseen_top()\n    if top:\n        cands.append({\"action\": \"search_similar_code\", \"node\": None, \"novelty\": 1.0,\n                      \"relevance\": max(env.n[u] for u in top),\n                      \"centrality\": (sum(env.loc.degree(u) for u in top) / len(top) / env.maxdeg) if use_centrality else 0.0})\n    bn, bg, bu = None, -1.0, []\n    for n in sorted(env.visited):\n        unv = env.nbrs(n)\n        if unv and max(env.n[m] for m in unv) > bg:\n            bn, bg, bu = n, max(env.n[m] for m in unv), unv\n    if bn is not None:\n        cands.append({\"action\": \"get_code_neighbors\", \"node\": bn, \"novelty\": min(1.0, len(bu) / env.k), \"relevance\": bg,\n                      \"centrality\": (env.loc.degree(bn) / env.maxdeg) if use_centrality else 0.0})\n    pool = env.pooled()\n    if len(env.visited) >= 2 and pool:\n        cands.append({\"action\": \"get_code_subgraph\", \"node\": None, \"novelty\": min(1.0, len(pool) / env.k),\n                      \"relevance\": max(env.n[m] for m in pool), \"centrality\": 0.5 if use_centrality else 0.0,\n                      \"components\": 2})\n    d = budget.decide({\"candidates\": [{**c, \"args\": {}} for c in cands]})\n    if d.get(\"stop\"):\n        return (\"search_similar_code\", None)\n    pick = next(c for c in cands if c[\"action\"] == d[\"action\"])\n    return (pick[\"action\"], pick[\"node\"])\n\n\ndef pol_infogain(env, rng=None):\n    return _infogain(env, True)\n\n\ndef pol_infogain_nocent(env, rng=None):\n    return _infogain(env, False)\n\n\nPOLICIES = {\"rank\": pol_rank, \"random_walk\": pol_random, \"graph_bfs\": pol_graph_bfs, \"best_first\": pol_best_first,\n            \"infogain\": pol_infogain, \"infogain_no_centrality\": pol_infogain_nocent}\n\n\ndef run_nav(env, policy, seed=0):\n    rng, pol = random.Random(seed), POLICIES[policy]\n    while not env.done():\n        action, node = pol(env, rng)\n        env.act(action, node)\n    return env.result()\n'''\n\nfor name, text in MODULES.items():\n    (PKG / name).write_text(text)\nprint('wrote forgex v2:', sorted(MODULES))","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:27:30.997213Z","iopub.execute_input":"2026-10-27T17:27:30.997413Z","iopub.status.idle":"2026-10-27T17:27:31.020626Z","shell.execute_reply.started":"2026-10-27T17:27:30.997395Z","shell.execute_reply":"2026-10-27T17:27:31.020123Z"},"trusted":true},"outputs":[{"name":"stdout","text":"wrote forgex v2: ['__init__.py', 'ast_index.py', 'bm25.py', 'budget.py', 'env.py', 'failure.py', 'gold.py', 'graphprop.py', 'localize.py', 'metrics.py', 'query.py', 'similarity.py', 'tokens.py']\n","output_type":"stream"}],"execution_count":8},{"id":"b4e0f42c","cell_type":"code","source":"sys.path.insert(0, \"/tmp/forgex_pkg\")\nimport importlib, forgex\nimportlib.reload(forgex)\nfrom forgex import (index_repo, EvidenceLocalizer, parse_changes, gold_units, gold_files, rank_metrics, mean_rows,\n                    boot_ci, signflip_p, holm, paired, failure, budget, NavEnv, run_nav, POLICIES, clean_query)\nimport tempfile, textwrap as _tw, difflib\n\n# ---- synthetic repo with a class, a free function, a duplicated name in two files, and a test file ----\n_d = Path(tempfile.mkdtemp()); (_d / \"pkg\").mkdir(); (_d / \"tests\").mkdir()\n_core = _tw.dedent(\"\"\"\n    class Base:\n        def run(self, x):\n            y = self.step(x)\n            return y\n\n        def step(self, x):\n            return x\n\n    def helper(a):\n        return a\n\"\"\")\n(_d / \"pkg/core.py\").write_text(_core)\n(_d / \"pkg/other.py\").write_text(\"def helper(a):\\n    return a + 1\\n\\ndef caller():\\n    return helper(1)\\n\")\n(_d / \"tests/test_core.py\").write_text(\"from pkg.core import Base\\n\\ndef test_run():\\n    assert Base().run(1) == 1\\n\")\n_units, _files = index_repo(_d)\n_ids = {u.uid for u in _units}\nassert \"pkg/core.py::helper\" in _ids and \"pkg/other.py::helper\" in _ids, \"units must be unique per file (v1 merged them)\"\n_loc = EvidenceLocalizer(_units, _files)\nassert all(not u.is_test for u in _loc.units), \"tests must be excluded from candidates\"\nassert \"pkg/core.py::Base.step\" in _loc.neighbors(\"pkg/core.py::Base.run\"), \"self.step must resolve to Base.step\"\nassert \"pkg/other.py::helper\" in _loc.neighbors(\"pkg/other.py::caller\"), \"same-file helper must win over the other file's\"\nassert \"pkg/core.py::helper\" not in _loc.neighbors(\"pkg/other.py::caller\"), \"bare-name linking across files must not happen\"\n\ndef _ud(old, new, path=\"pkg/core.py\"):\n    return \"\".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True), f\"a/{path}\", f\"b/{path}\"))\ndef _gold(new):\n    return sorted(gold_units(_units, parse_changes(_ud(_core, new))))\nassert _gold(_core.replace(\"        return y\\n\", \"        return y * 2\\n\")) == [\"pkg/core.py::Base.run\"]          # last line of a middle method\nassert _gold(_core.replace(\"        return y\\n\", \"        return y\\n        z = 1\\n\")) == [\"pkg/core.py::Base.run\"]  # pure addition inside a method\nassert _gold(_core.replace(\"        return y\\n\\n\", \"        return y\\n\\n    def extra(self):\\n        return 0\\n\\n\")) == [\"pkg/core.py::Base\"]  # new sibling method\nassert _gold(_core.replace(\"def helper(a):\\n    return a\\n\", \"def helper(a):\\n    return a + 0\\n\")) == [\"pkg/core.py::helper\"]\n_hunk_ctx = _ud(_core, _core.replace(\"    return a\\n\", \"    return a + 0\\n\"))\nassert len(gold_units(_units, parse_changes(_hunk_ctx))) == 1, \"context lines must not create gold units\"\n\n# ---- retrieval sanity ----\n_order = _loc.rank_units(\"Base.run returns the wrong value when step is called\")\nassert \"pkg/core.py::Base.run\" in _order[:3], _order[:3]      # the named method must be among the top results\n\n# ---- query cleaning (task statements are pull-request descriptions with template boilerplate) ----\n_pr = \"Fix thing\\n\\n<!-- hidden note -->\\n## Checklist\\n- [x] I've added tests for new code.\\n- [ ] Documentation\\n\\nReal description of the change in `foo_bar`. See #123 and https://x.y/z\"\n_c = clean_query(_pr, 1)\nassert _c.startswith(\"Fix thing\") and \"foo_bar\" in _c, _c\nassert not any(w in _c.lower() for w in (\"hidden\", \"checklist\", \"tests\", \"documentation\", \"123\", \"http\")), _c\nassert clean_query(\"Only a title\", 3).count(\"Only a title\") == 3 and clean_query(\"\") == \"\"\n\n# ---- failure classifier and scorer (v1 tests kept; Contribution B is NOT evaluated beyond these) ----\n_S = failure.Step\nassert failure.classify_failure([_S(\"run_command\", {}, tests_run=10, tests_passed=8, tests_failed=2, changed_files=[\"m.py\"],\n                                    stdout=\"FAILED t.py::test_x\")])[\"label\"] == \"localization_error\"\nassert failure.classify_failure([_S(\"run_command\", {}, tests_run=10, tests_passed=9, tests_failed=1, new_failures=[\"test_o\"],\n                                    changed_files=[\"m.py\"])])[\"label\"] == \"regression\"\nassert failure.classify_failure([])[\"label\"] == \"incomplete_verification\"\n_r = budget.decide({\"candidates\": [{\"action\": \"get_code_neighbors\", \"args\": {}, \"novelty\": 0.0, \"relevance\": 1.0},\n                                   {\"action\": \"search_similar_code\", \"args\": {}, \"novelty\": 0.8, \"relevance\": 0.6, \"centrality\": 0.4}]})\nassert _r[\"action\"] == \"search_similar_code\", _r\nprint(\"forgex v2 self-test: PASSED\")","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:27:31.021467Z","iopub.execute_input":"2026-10-27T17:27:31.021667Z","iopub.status.idle":"2026-10-27T17:27:33.011265Z","shell.execute_reply.started":"2026-10-27T17:27:31.021648Z","shell.execute_reply":"2026-10-27T17:27:33.010706Z"},"trusted":true},"outputs":[{"name":"stdout","text":"forgex v2 self-test: PASSED\n","output_type":"stream"}],"execution_count":9},{"id":"4f355459","cell_type":"markdown","source":"## 3. Phase 1: evaluate localization and navigation on every task (CPU)\nOne pass per task: build the index on the pre-fix snapshot, derive gold from the changed lines, score every system, and run the navigation policies. Results are cached to `OUT/phase1_rows.pkl` so an interrupted run resumes.\n\n**Systems (each adds one thing to the previous):**\n\n| System | Adds |\n|---|---|\n| A0 | v1-style: BM25 over unit text, tests included as candidates |\n| A1 | exclude test code from the candidates |\n| A2 | class documents use the header and method names instead of all bodies |\n| A3 | BM25 over names and paths as a second evidence source |\n| A4 | exact identifier and path signals taken from the task text |\n| A5 | **v3:** remove pull-request template boilerplate (checklists, HTML comments, headings, URLs, issue numbers) from the query |\n| graph | A5 plus a small bonus for resolved neighbours of the top-K seeds (grid over beta and K) |\n\nUnit metrics are computed on tasks with at least one gold unit; file metrics on all tasks. Selection of beta and K uses **leave-one-repository-out** (section 4), so no setting is picked on the tasks it is reported on.","metadata":{}},{"id":"ac52675f","cell_type":"code","source":"A4_KW = dict(w_lex=1, w_name=0.3, w_sig=0.5)\nSYS = {\n    \"A0 v1-style BM25 (tests included)\": dict(loc=\"v1t\", qv=\"raw\", kw=dict(w_lex=1, w_name=0, w_sig=0)),\n    \"A1 + tests excluded\":               dict(loc=\"v1\",  qv=\"raw\", kw=dict(w_lex=1, w_name=0, w_sig=0)),\n    \"A2 + class-header documents\":       dict(loc=\"v2\",  qv=\"raw\", kw=dict(w_lex=1, w_name=0, w_sig=0)),\n    \"A3 + name/path evidence\":           dict(loc=\"v2\",  qv=\"raw\", kw=dict(w_lex=1, w_name=0.3, w_sig=0)),\n    \"A4 + identifier/path signals\":      dict(loc=\"v2\",  qv=\"raw\", kw=A4_KW),\n    \"A5 + cleaned query (PR boilerplate removed)\": dict(loc=\"v2\", qv=\"clean\", kw=A4_KW),\n}\nif CFG[\"RUN_TFIDF\"]:\n    SYS[\"A5 + TF-IDF\"] = dict(loc=\"v2\", qv=\"clean\", kw=dict(A4_KW, w_sim=0.3))\n# sensitivity rows (reported, not part of the chain)\nSENS = {\n    \"S1 cleaned query, title x3\":        dict(loc=\"v2\", qv=\"clean_t3\", kw=A4_KW),\n    \"S2 raw-query graph b=0.2 K=10 (v2 setting)\": dict(loc=\"v2\", qv=\"raw\", kw=dict(A4_KW, beta=0.2, K=10, steps=1)),\n}\n# graph grid on the cleaned query (the stage after A5)\nGRAPH_SYS = {f\"graph b={b} K={K}\": dict(loc=\"v2\", qv=\"clean\", kw=dict(A4_KW, beta=b, K=K, steps=1))\n             for b in CFG[\"GRAPH_BETAS\"] for K in CFG[\"GRAPH_KS\"]}\nALL_SYS = {**SYS, **SENS, **GRAPH_SYS}\nNAV_GRAPH_KW = dict(A4_KW, beta=0.2, K=10, steps=1)\nNAV_KW = dict(A4_KW)\nQV = {\"raw\": lambda s: s, \"clean\": lambda s: clean_query(s, 1), \"clean_t3\": lambda s: clean_query(s, 3)}\n\ndef _ranked(sc):\n    return [k for k, _ in sorted(sc.items(), key=lambda kv: (-kv[1], kv[0]))]\n\ndef evaluate_task(t):\n    units, files = index_repo(t[\"repo_root\"])\n    ch = parse_changes(t[\"patch\"])\n    gu, gf = gold_units(units, ch), gold_files(ch)\n    locs = {\"v2\": EvidenceLocalizer(units, files),\n            \"v1\": EvidenceLocalizer(units, files, doc_mode=\"v1\"),\n            \"v1t\": EvidenceLocalizer(units, files, exclude_tests=False, doc_mode=\"v1\")}\n    preps = {}\n    for s in ALL_SYS.values():                       # one prepared query per (localizer, query variant)\n        key = (s[\"loc\"], s[\"qv\"])\n        if key not in preps:\n            preps[key] = locs[s[\"loc\"]].prepare(QV[s[\"qv\"]](t[\"issue\"]))\n    out = {\"instance_id\": t[\"instance_id\"], \"repo\": t[\"repo_id\"], \"n_gold_units\": len(gu), \"n_gold_files\": len(gf),\n           \"n_units\": len(locs[\"v2\"].units), \"graph\": locs[\"v2\"].graph_stats, \"rows\": {}, \"nav\": []}\n    for name, s in ALL_SYS.items():\n        l, p = locs[s[\"loc\"]], preps[(s[\"loc\"], s[\"qv\"])]\n        r = {}\n        if gu:\n            r.update({f\"unit/{a}\": b for a, b in rank_metrics(l.rank_units(p, **s[\"kw\"]), gu).items()})\n        if gf:\n            r.update({f\"file/{a}\": b for a, b in rank_metrics(l.rank_files(p, **s[\"kw\"]), gf, ks=(1, 3, 5)).items()})\n        out[\"rows\"][name] = r\n    if gu:                                   # navigation runs only where a gold unit exists; uses the cleaned query\n        l, p = locs[\"v2\"], preps[(\"v2\", \"clean\")]\n        sc, scg = l.unit_scores(p, **NAV_KW), l.unit_scores(p, **NAV_GRAPH_KW)\n        for pol in POLICIES:\n            for sd in (CFG[\"NAV_SEEDS\"] if pol == \"random_walk\" else [0]):\n                r = run_nav(NavEnv(l, sc, _ranked(sc), gu, CFG[\"NAV_BUDGET\"], CFG[\"NAV_K\"]), pol, sd)\n                out[\"nav\"].append({**r, \"instance_id\": t[\"instance_id\"], \"policy\": pol, \"seed\": sd, \"repo\": t[\"repo_id\"]})\n        r = run_nav(NavEnv(l, scg, _ranked(scg), gu, CFG[\"NAV_BUDGET\"], CFG[\"NAV_K\"]), \"rank\", 0)\n        out[\"nav\"].append({**r, \"instance_id\": t[\"instance_id\"], \"policy\": \"rank+graph\", \"seed\": 0, \"repo\": t[\"repo_id\"]})\n    return out\n\ncache_f = CFG[\"OUT\"] / \"phase1_rows_v3.pkl\"\nEVAL = {r[\"instance_id\"]: r for r in pickle.load(open(cache_f, \"rb\"))} if cache_f.exists() else {}\nt0 = time.time()\nfor n, t in enumerate(tasks, 1):\n    if t[\"instance_id\"] in EVAL:\n        continue\n    try:\n        EVAL[t[\"instance_id\"]] = evaluate_task(t)\n    except Exception as e:\n        print(f\"{t['instance_id']}: skipped ({type(e).__name__}: {str(e)[:120]})\")\n    if n % 10 == 0:\n        print(f\"  {n}/{len(tasks)} tasks | {time.time() - t0:.0f}s\")\n        pickle.dump(list(EVAL.values()), open(cache_f, \"wb\"))\npickle.dump(list(EVAL.values()), open(cache_f, \"wb\"))\nRES = [EVAL[t[\"instance_id\"]] for t in tasks if t[\"instance_id\"] in EVAL]\nprint(f\"done: {len(RES)} tasks | with a gold unit: {sum(1 for r in RES if r['n_gold_units'])} | \"\n      f\"file-level only: {sum(1 for r in RES if not r['n_gold_units'] and r['n_gold_files'])} | {time.time() - t0:.0f}s\")\nimport statistics as st\ngl = [r[\"n_gold_units\"] for r in RES if r[\"n_gold_units\"]]\ng = [r[\"graph\"] for r in RES]\nprint(f\"gold units per task: median {st.median(gl)}, mean {st.mean(gl):.2f} (v1 labelling gave a mean of about 6.5)\")\nprint(f\"call edges resolved: {sum(x['resolved'] for x in g) / max(1, sum(x['calls'] for x in g)):.1%} | mean max degree {st.mean(x['max_degree'] for x in g):.0f}\")","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:27:33.011988Z","iopub.execute_input":"2026-10-27T17:27:33.012199Z","iopub.status.idle":"2026-10-27T17:33:10.387155Z","shell.execute_reply.started":"2026-10-27T17:27:33.012181Z","shell.execute_reply":"2026-10-27T17:33:10.38657Z"},"trusted":true},"outputs":[{"name":"stdout","text":"  10/129 tasks | 34s\n  20/129 tasks | 43s\n  30/129 tasks | 72s\n  40/129 tasks | 109s\n  50/129 tasks | 145s\n  60/129 tasks | 181s\n  70/129 tasks | 208s\n  80/129 tasks | 230s\n  90/129 tasks | 268s\n  100/129 tasks | 286s\n  110/129 tasks | 303s\n  120/129 tasks | 321s\ndone: 129 tasks | with a gold unit: 107 | file-level only: 22 | 337s\ngold units per task: median 1, mean 1.91 (v1 labelling gave a mean of about 6.5)\ncall edges resolved: 28.3% | mean max degree 90\n","output_type":"stream"}],"execution_count":10},{"id":"12b38ac5","cell_type":"markdown","source":"## 4. Contribution A: results\nPrimary metric (fixed in advance): **unit MRR**. The chain order is fixed in advance too; A5 and the title-weight row were added in v3 after inspecting the task text (see the limits in the header). Secondary: unit acc@5 and file acc@3. Paired differences use a bootstrap interval and a sign-flip test, with **Holm correction over all comparisons in the table**.","metadata":{}},{"id":"86b683eb","cell_type":"code","source":"import pandas as pd\nfrom IPython.display import display\n\nKEYS = [\"unit/acc@1\", \"unit/acc@3\", \"unit/acc@5\", \"unit/acc@10\", \"unit/mrr\", \"file/acc@1\", \"file/acc@3\", \"file/acc@5\"]\nrepos = sorted({r[\"repo\"] for r in RES})\n\ndef rows_of(name):\n    return [{\"instance_id\": r[\"instance_id\"], **r[\"rows\"][name]} for r in RES if r[\"rows\"].get(name)]\n\ndef mrr_on(name, subset):\n    v = [r[\"rows\"][name][\"unit/mrr\"] for r in subset if \"unit/mrr\" in r[\"rows\"].get(name, {})]\n    return sum(v) / len(v) if v else 0.0\n\n# leave-one-repository-out choice of the graph setting (unit MRR on the OTHER repositories)\nloro_rows, picks = [], {}\nfor rep in repos:\n    train, test = [r for r in RES if r[\"repo\"] != rep], [r for r in RES if r[\"repo\"] == rep]\n    best = max(GRAPH_SYS, key=lambda n: mrr_on(n, train))\n    picks[rep] = best\n    loro_rows += [{\"instance_id\": r[\"instance_id\"], **r[\"rows\"][best]} for r in test if r[\"rows\"].get(best)]\nprint(\"graph setting chosen without each repository:\", picks)\n\nSYSROWS = {n: rows_of(n) for n in SYS}\nSYSROWS[\"graph (leave-one-repo-out choice)\"] = loro_rows\ntbl = pd.DataFrame({n: forgex.mean_rows(rows, KEYS) for n, rows in SYSROWS.items()}).T.round(3)\ntbl[\"n_u