 \"--query-gpu=index,memory.used,memory.total,utilization.gpu,utilization.memory,power.draw\", \"--format=csv,noheader,nounits\"])\n    return {\"timestamp\": time.time(), \"result\": result}\n\ndef run_eval_arm(arm_name, submission_dir):\n    result_dir = ACTIVE_RUN_ROOT / arm_name\n    result_dir.mkdir(parents=True, exist_ok=True)\n    cmd = [\n        SWEGEMMA, \"eval\",\n        \"--tasks\", str(TASKS_PATH),\n        \"--snapshots-dir\", str(SNAPSHOTS_DIR),\n        \"--submission-dir\", str(submission_dir),\n        \"--results-dir\", str(result_dir),\n        \"--sandbox\", SANDBOX,\n        \"--max-tool-calls\", str(MAX_TOOL_CALLS),\n        \"--max-time-minutes\", str(MAX_TIME_MINUTES),\n        \"--timeout-seconds\", str(TIMEOUT_SECONDS),\n        \"--verification-timeout-seconds\", str(VERIFY_TIMEOUT_SECONDS),\n        \"--concurrency\", str(CONCURRENCY),\n    ]\n    if N_TASKS is not None and N_TASKS < len(all_task_ids):\n        cmd.extend([\"--task-ids\", *selected_task_ids])\n    env = os.environ.copy()\n    env[\"SWE_MAX_TURNS\"] = str(CFG[\"SUB_BUDGET\"].get(\"turns\", 500))\n    # Keep all four GPUs visible to the harness. Do not force a separate CUDA mask here.\n    (result_dir / \"command.json\").write_text(json.dumps({\n        \"command\": cmd, \"arm\": arm_name, \"submission_dir\": str(submission_dir),\n        \"task_ids\": selected_task_ids, \"run_mode\": RUN_MODE,\n        \"env_overrides\": {\"SWE_MAX_TURNS\": env[\"SWE_MAX_TURNS\"]},\n        \"gpu_policy_expected_from_harness\": {\"tensor_parallel_size\": 4, \"gpu_memory_utilization\": 0.90, \"max_model_len\": 32768}\n    }, indent=2))\n    print(\"\\n\" + \"=\" * 90 + \"\\nRUN:\", arm_name, \"\\nCOMMAND:\", shlex.join(cmd), \"\\nRESULTS:\", result_dir)\n    started = time.time()\n    stdout_path = result_dir / \"stdout.log\"\n    stderr_path = result_dir / \"stderr.log\"\n    # Stream output to files to avoid deadlocks from full subprocess pipes.\n    with open(stdout_path, \"w\", encoding=\"utf-8\") as stdout_file, open(stderr_path, \"w\", encoding=\"utf-8\") as stderr_file:\n        proc = subprocess.Popen(cmd, text=True, stdout=stdout_file, stderr=stderr_file, env=env)\n        telemetry = []\n        last_sample = 0\n        hard_timeout = MAX_TIME_MINUTES * 60 + VERIFY_TIMEOUT_SECONDS + 300\n        timeout_hit = False\n        while proc.poll() is None:\n            if time.time() - started > hard_timeout:\n                proc.terminate()\n                try:\n                    proc.wait(timeout=20)\n                except subprocess.TimeoutExpired:\n                    proc.kill()\n                    proc.wait(timeout=10)\n                timeout_hit = True\n                break\n            now = time.time()\n            if now - last_sample >= 30:\n                telemetry.append(gpu_snapshot())\n                last_sample = now\n            time.sleep(3)\n        returncode = proc.wait(timeout=15)\n    if not telemetry or time.time() - last_sample > 5:\n        telemetry.append(gpu_snapshot())\n    elapsed = time.time() - started\n    stdout = stdout_path.read_text(encoding=\"utf-8\", errors=\"replace\") if stdout_path.exists() else \"\"\n    stderr = stderr_path.read_text(encoding=\"utf-8\", errors=\"replace\") if stderr_path.exists() else \"\"\n    (result_dir / \"gpu_telemetry.json\").write_text(json.dumps(telemetry, indent=2))\n    run_info = {\"arm\": arm_name, \"returncode\": returncode, \"timed_out\": timeout_hit, \"elapsed_seconds\": round(elapsed, 2), \"command\": cmd,\n                \"gpu_samples\": len(telemetry), \"gpu_telemetry_file\": str(result_dir / \"gpu_telemetry.json\")}\n    (result_dir / \"run_status.json\").write_text(json.dumps(run_info, indent=2))\n    print(\"return code:\", returncode, \"elapsed seconds:\", round(elapsed, 1), \"GPU samples:\", len(telemetry))\n    if stdout:\n        print(stdout[-5000:])\n    if stderr:\n        print(\"STDERR (last 3000 chars):\\n\", stderr[-3000:])\n    # Do not abort the entire experiment: preserve the failure and attempt the remaining arms.\n    # The parser below will mark this arm invalid and block comparative claims.\n    if timeout_hit:\n        print(f\"INVALID RUN: {arm_name} timed out; continuing so other arms get a recorded status.\")\n    elif returncode != 0:\n        print(f\"INVALID RUN: {arm_name} exited {returncode}; continuing. Inspect logs before interpreting metrics.\")\n    else:\n        print(f\"Harness process exited successfully for {arm_name}; task-level validity is checked separately.\")\n    return result_dir\n\nrun_dirs = {}\nfor arm_name, submission_dir in submission_arms:\n    try:\n        run_dirs[arm_name] = run_eval_arm(arm_name, submission_dir)\n    except Exception as exc:\n        # Capture launch failures too, so they cannot masquerade as missing-but-complete data.\n        failed_dir = ACTIVE_RUN_ROOT / arm_name\n        failed_dir.mkdir(parents=True, exist_ok=True)\n        (failed_dir / \"run_status.json\").write_text(json.dumps({\n            \"arm\": arm_name, \"returncode\": -1, \"timed_out\": False,\n            \"launch_exception\": repr(exc), \"infrastructure_failure\": True\n        }, indent=2))\n        run_dirs[arm_name] = failed_dir\n        print(f\"INVALID RUN: {arm_name} could not launch: {exc!r}\")\nprint(\"Recorded all arm attempts:\", {k: str(v) for k, v in run_dirs.items()})\n","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:49:38.226007Z","iopub.execute_input":"2026-10-27T17:49:38.226755Z","execution_failed":"2026-10-27T18:04:06.34Z"},"trusted":true},"outputs":[{"name":"stdout","text":"\n==========================================================================================\nRUN: E1_official_baseline \nCOMMAND: /usr/local/bin/swegemma eval --tasks /kaggle/input/competitions/gemma-4-developer-agent/tasks.jsonl --snapshots-dir /kaggle/input/competitions/gemma-4-developer-agent/snapshots --submission-dir /kaggle/input/competitions/gemma-4-developer-agent/sample_submission --results-dir /kaggle/working/forgex_patch_passrate/runs/20261027T173338Z/E1_official_baseline --sandbox subprocess --max-tool-calls 30 --max-time-minutes 15 --timeout-seconds 600 --verification-timeout-seconds 600 --concurrency 1 --task-ids fastapi_14371 fastapi_14419 fastapi_14492 fastapi_14873 rich_3061 \nRESULTS: /kaggle/working/forgex_patch_passrate/runs/20261027T173338Z/E1_official_baseline\n","output_type":"stream"}],"execution_count":null},{"id":"d8a40c28-fa3e-4fa0-bff0-9697e50cefdc","cell_type":"markdown","source":"### 10.4 Parse official metrics and per-task outcomes\n\nThe parser looks for the documented `summary.json` and `task_results.jsonl` artifacts. The strict parser rejects missing/duplicate task IDs, unknown outcomes, nonzero harness exits, and known infrastructure failures. Field names can vary by harness version; inspect raw JSON and update mappings rather than inferring. If a metric is blank, inspect the raw JSON files and adapt the field mapping to the exact harness output.\n","metadata":{}},{"id":"6c1bda88-7979-4003-a95e-0f02986fb9ea","cell_type":"code","source":"def load_json(path):\n    try:\n        return json.loads(Path(path).read_text(encoding=\"utf-8\"))\n    except (FileNotFoundError, json.JSONDecodeError, OSError):\n        return None\n\ndef load_result_rows(path):\n    rows = []\n    if Path(path).is_file():\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            for line_no, line in enumerate(f, start=1):\n                if not line.strip():\n                    continue\n                try:\n                    obj = json.loads(line)\n                    if isinstance(obj, dict):\n                        rows.append(obj)\n                except json.JSONDecodeError:\n                    print(f\"WARNING: skipped malformed JSONL line {line_no} in {path}\")\n    return rows\n\ndef first_present(obj, keys):\n    if not isinstance(obj, dict):\n        return None\n    for k in keys:\n        if k in obj and obj[k] is not None:\n            return obj[k]\n    return None\n\ndef task_id_of(row):\n    value = first_present(row, [\"instance_id\", \"task_id\", \"id\"])\n    return str(value) if value is not None else None\n\ndef resolved_of(row):\n    value = first_present(row, [\"resolved\", \"success\", \"passed\", \"is_resolved\"])\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, (int, float)) and value in (0, 1):\n        return bool(value)\n    status = first_present(row, [\"status\", \"result\", \"outcome\"])\n    if isinstance(status, str):\n        low = status.strip().lower()\n        if low in {\"resolved\", \"passed\", \"pass\", \"success\", \"successful\", \"true\"}:\n            return True\n        if low in {\"unresolved\", \"failed\", \"fail\", \"failure\", \"false\"}:\n            return False\n    return None\n\nINFRA_PATTERNS = [\n    r\"error while fetching server api version\",\n    r\"docker daemon.*(not running|unavailable|connection refused)\",\n    r\"cannot connect to the docker daemon\",\n    r\"no such file or directory.*(docker|container)\",\n    r\"failed to create.*sandbox\",\n    r\"failed to launch.*(worker|sandbox|container)\",\n    r\"connection aborted.*file not found\",\n    r\"module not found.*(swegemma|adk_eval_core)\",\n    r\"command not found.*swegemma\",\n]\ndef detect_infrastructure_failure(result_dir, run_status, rows):\n    import re\n    reasons = []\n    if not isinstance(run_status, dict):\n        reasons.append(\"missing run_status.json\")\n    else:\n        if run_status.get(\"launch_exception\"):\n            reasons.append(\"harness launch exception\")\n        if run_status.get(\"timed_out\") is True:\n            reasons.append(\"outer harness timeout\")\n        rc = run_status.get(\"returncode\")\n        if not isinstance(rc, int) or rc != 0:\n            reasons.append(f\"nonzero/missing harness return code: {rc!r}\")\n    text_parts = []\n    for name in (\"stdout.log\", \"stderr.log\"):\n        p = Path(result_dir) / name\n        if p.is_file():\n            text_parts.append(p.read_text(encoding=\"utf-8\", errors=\"replace\")[-200000:])\n    logs = \"\\n\".join(text_parts).lower()\n    for pattern in INFRA_PATTERNS:\n        if re.search(pattern, logs, re.I):\n            reasons.append(f\"infra log signature: {pattern}\")\n    # Harness-level worker errors in rows are not ordinary unresolved bugs.\n    for row in rows:\n        status = str(first_present(row, [\"status\", \"result\", \"outcome\", \"error_type\"]) or \"\").lower()\n        err = str(first_present(row, [\"error\", \"exception\", \"error_message\", \"failure_reason\"]) or \"\").lower()\n        if any(x in status for x in (\"infrastructure_error\", \"worker_error\", \"sandbox_error\", \"launch_error\")):\n            reasons.append(f\"task row has infrastructure status: {status[:100]}\")\n            break\n        if any(x in err for x in (\"server api version\", \"docker daemon\", \"failed to create sandbox\", \"worker launch\")):\n            reasons.append(\"task row contains infrastructure exception\")\n            break\n    return sorted(set(reasons))\n\ndef summarize_arm(arm_name, result_dir):\n    result_dir = Path(result_dir)\n    summary = load_json(result_dir / \"summary.json\") or {}\n    run_status = load_json(result_dir / \"run_status.json\")\n    task_rows = load_result_rows(result_dir / \"task_results.jsonl\")\n    ids = [task_id_of(r) for r in task_rows]\n    ids_nonnull = [x for x in ids if x is not None]\n    duplicates = sorted({x for x in ids_nonnull if ids_nonnull.count(x) > 1})\n    outcome_by_id = {}\n    for row in task_rows:\n        tid = task_id_of(row)\n        if tid is not None:\n            outcome_by_id[tid] = resolved_of(row)\n    observed_ids = set(outcome_by_id)\n    expected_ids = set(map(str, selected_task_ids))\n    missing_ids = sorted(expected_ids - observed_ids)\n    unexpected_ids = sorted(observed_ids - expected_ids)\n    unknown_ids = sorted(tid for tid in expected_ids if tid in outcome_by_id and outcome_by_id[tid] is None)\n    infra_reasons = detect_infrastructure_failure(result_dir, run_status, task_rows)\n    valid_outcomes = {tid: outcome_by_id[tid] for tid in expected_ids\n                      if tid in outcome_by_id and outcome_by_id[tid] is not None}\n    # Validity requires all selected tasks exactly once and successful harness execution.\n    valid = (not infra_reasons and not duplicates and not missing_ids and not unexpected_ids\n             and not unknown_ids and len(task_rows) == len(selected_task_ids)\n             and set(valid_outcomes) == expected_ids)\n    resolved_count = sum(v is True for v in valid_outcomes.values()) if valid else None\n    rate = (resolved_count / len(selected_task_ids)) if valid and selected_task_ids else None\n    return {\n        \"arm\": arm_name, \"valid_run\": bool(valid), \"resolution_rate\": rate,\n        \"resolved\": resolved_count, \"total_expected\": len(selected_task_ids),\n        \"task_result_rows\": len(task_rows), \"unique_task_ids\": len(observed_ids),\n        \"missing_task_ids\": missing_ids, \"unexpected_task_ids\": unexpected_ids,\n        \"duplicate_task_ids\": duplicates, \"unknown_outcome_task_ids\": unknown_ids,\n        \"infrastructure_failure_reasons\": infra_reasons,\n        \"harness_returncode\": run_status.get(\"returncode\") if isinstance(run_status, dict) else None,\n        \"elapsed_seconds\": run_status.get(\"elapsed_seconds\") if isinstance(run_status, dict) else None,\n        \"summary_path\": str(result_dir / \"summary.json\"),\n        \"task_results_path\": str(result_dir / \"task_results.jsonl\"),\n    }, task_rows, summary, outcome_by_id\n\nsummaries, rows_by_arm, raw_summaries, outcomes_by_arm = [], {}, {}, {}\nfor arm_name, result_dir in run_dirs.items():\n    sm, rows, raw, outcome_map = summarize_arm(arm_name, result_dir)\n    summaries.append(sm)\n    rows_by_arm[arm_name] = rows\n    raw_summaries[arm_name] = raw\n    outcomes_by_arm[arm_name] = outcome_map\n    print(\"\\n\", arm_name, \"summary keys:\", sorted(raw.keys()))\n    print(json.dumps(sm, indent=2))\nsummary_df = pd.DataFrame(summaries)\ndisplay(summary_df)\nsummary_df.to_csv(EVAL_ROOT / \"patch_passrate_summary.csv\", index=False)\n(EVAL_ROOT / \"raw_summaries.json\").write_text(json.dumps(raw_summaries, indent=2, default=str))\n","metadata":{"execution":{"execution_failed":"2026-10-27T18:04:06.344Z"},"trusted":true},"outputs":[],"execution_count":null},{"id":"98734355-5477-4b8a-a8b8-84919541394e","cell_type":"markdown","source":"### 10.5 Paired task-level comparison\n\nThe primary task-level pairing is E4_failure_controller versus E2_forgex_no_controller, the matched prompt ablation. Pairing compares methods on the same issues. The analysis reports common task IDs separately from valid pairs, unknown outcomes, wins, losses, ties, and changed outcomes. If the harness uses a different schema, inspect the raw rows and update the field mapping before interpreting results.\n","metadata":{}},{"id":"fc019d90-b833-4e60-814d-4521fee9bf6d","cell_type":"code","source":"from math import comb\nimport numpy as np\n\nPRIMARY_BASELINE = \"E2_forgex_no_controller\"\nPRIMARY_CONTROLLER = \"E4_failure_controller\"\nARM_NAME_MAP = {\n    \"E1_official_baseline\": SAMPLE_SUBMISSION_DIR,\n    \"E2_forgex_no_controller\": FORGEX_CURRENT_DIR,\n    \"E3_evidence_localization\": FORGEX_LOCALIZATION_DIR,\n    \"E4_failure_controller\": FORGEX_CONTROLLER_DIR,\n    \"E5_full_forge_ar\": SUB,\n}\n\ndef bootstrap_mean_ci(values, n_boot=10000, seed=2026):\n    vals = np.asarray(values, dtype=float)\n    if len(vals) == 0:\n        return (None, None)\n    rng = np.random.default_rng(seed)\n    samples = rng.choice(vals, size=(n_boot, len(vals)), replace=True).mean(axis=1)\n    lo, hi = np.quantile(samples, [0.025, 0.975])\n    return float(lo), float(hi)\n\ndef mcnemar_exact_two_sided(wins, losses):\n    # Exact two-sided binomial test over discordant pairs, no SciPy dependency.\n    n = int(wins + losses)\n    if n == 0:\n        return 1.0\n    k = min(int(wins), int(losses))\n    tail = sum(comb(n, i) for i in range(k + 1)) / (2 ** n)\n    return min(1.0, 2 * tail)\n\ndef paired_controller_comparison(base_name, controller_name):\n    base_summary = next((x for x in summaries if x[\"arm\"] == base_name), None)\n    ctrl_summary = next((x for x in summaries if x[\"arm\"] == controller_name), None)\n    if not base_summary or not ctrl_summary:\n        return {\"claim_status\": \"BLOCKED\", \"reason\": \"one or both primary arms missing\"}\n    if not base_summary[\"valid_run\"] or not ctrl_summary[\"valid_run\"]:\n        return {\"claim_status\": \"BLOCKED\",\n                \"reason\": \"strict validity gate failed for at least one primary arm\",\n                \"baseline_valid\": base_summary[\"valid_run\"],\n                \"controller_valid\": ctrl_summary[\"valid_run\"],\n                \"baseline_infra\": base_summary[\"infrastructure_failure_reasons\"],\n                \"controller_infra\": ctrl_summary[\"infrastructure_failure_reasons\"]}\n    base = outcomes_by_arm[base_name]\n    ctrl = outcomes_by_arm[controller_name]\n    ids = sorted(set(map(str, selected_task_ids)))\n    if set(base) != set(ids) or set(ctrl) != set(ids):\n        return {\"claim_status\": \"BLOCKED\", \"reason\": \"task ID sets differ from selected task set\"}\n    diffs, wins, losses, ties = [], 0, 0, 0\n    task_rows = []\n    for tid in ids:\n        b, c = base[tid], ctrl[tid]\n        if b not in (True, False) or c not in (True, False):\n            return {\"claim_status\": \"BLOCKED\", \"reason\": f\"unknown outcome for task {tid}\"}\n        diffs.append(int(c) - int(b))\n        if c and not b: wins += 1\n        elif b and not c: losses += 1\n        else: ties += 1\n        task_rows.append({\"task_id\": tid, \"no_controller_resolved\": b, \"controller_resolved\": c,\n                          \"paired_difference\": int(c) - int(b),\n                          \"paired_outcome\": \"controller_win\" if c and not b else\n                                            \"controller_loss\" if b and not c else \"tie\"})\n    delta = float(np.mean(diffs))\n    lo, hi = bootstrap_mean_ci(diffs)\n    p = mcnemar_exact_two_sided(wins, losses)\n    result = {\n        \"claim_status\": \"VALID_COMPARISON_PRELIMINARY\" if len(ids) < 30 else \"VALID_COMPARISON\",\n        \"baseline_arm\": base_name, \"controller_arm\": controller_name, \"n_paired_tasks\": len(ids),\n        \"baseline_resolved\": sum(base[t] is True for t in ids),\n        \"controller_resolved\": sum(ctrl[t] is True for t in ids),\n        \"baseline_resolution_rate\": float(np.mean([base[t] for t in ids])),\n        \"controller_resolution_rate\": float(np.mean([ctrl[t] for t in ids])),\n        \"absolute_resolution_rate_difference\": delta, \"bootstrap_95ci_low\": lo, \"bootstrap_95ci_high\": hi,\n        \"controller_wins\": wins, \"controller_losses\": losses, \"ties\": ties,\n        \"mcnemar_exact_two_sided_p\": p,\n        \"interpretation\": (\"descriptive positive difference; uncertainty includes zero or sample is small\"\n                           if delta > 0 and (lo is None or lo <= 0 or len(ids) < 30)\n                           else \"positive paired difference with interval above zero; still assess multiplicity and external validity\"\n                           if delta > 0 and lo > 0\n                           else \"no observed positive resolution-rate difference\" if delta <= 0\n                           else \"inconclusive\")\n    }\n    pd.DataFrame(task_rows).to_csv(EVAL_ROOT / \"primary_controller_paired_tasks.csv\", index=False)\n    return result\n\nprimary_result = paired_controller_comparison(PRIMARY_BASELINE, PRIMARY_CONTROLLER)\n(EVAL_ROOT / \"primary_controller_comparison.json\").write_text(json.dumps(primary_result, indent=2))\nprint(\"PRIMARY TEST: failure-controller prompt (E4) vs matched no-controller prompt (E2)\")\nprint(json.dumps(primary_result, indent=2))\n\n# Secondary arm comparisons are allowed only if both arms passed the same strict validity gate.\nsecondary = []\nvalid_by_name = {x[\"arm\"]: x[\"valid_run\"] for x in summaries}\nfor base_name, candidate_name in [\n    (\"E2_forgex_no_controller\", \"E3_evidence_localization\"),\n    (\"E2_forgex_no_controller\", \"E5_full_forge_ar\"),\n    (\"E4_failure_controller\", \"E5_full_forge_ar\"),\n]:\n    if valid_by_name.get(base_name) and valid_by_name.get(candidate_name):\n        secondary.append(paired_controller_comparison(base_name, candidate_name))\n    else:\n        secondary.append({\"claim_status\": \"BLOCKED\", \"baseline_arm\": base_name,\n                          \"candidate_arm\": candidate_name, \"reason\": \"strict validity gate failed\"})\n(EVAL_ROOT / \"secondary_paired_comparisons.json\").write_text(json.dumps(secondary, indent=2))\nprint(\"Secondary comparisons:\")\nprint(json.dumps(secondary, indent=2))\n","metadata":{"execution":{"execution_failed":"2026-10-27T18:04:06.341Z"},"trusted":true},"outputs":[],"execution_count":null},{"id":"7b564855-057f-44f5-8fa7-376fb1574149","cell_type":"markdown","source":"### 10.6 Reproducibility manifest and final report\n\nThis report records paths, budgets, task IDs, submission hashes, and outputs. Keep it with the experiment. A strict validity gate blocks claims when infrastructure or task outcomes are incomplete. A higher rate on a small screening set is only preliminary evidence; repeat with a larger set and report uncertainty before making a research claim.\n","metadata":{}},{"id":"9e056df9-2cba-422e-a727-8a09902bb886","cell_type":"code","source":"def sha256_file(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\ndef hash_tree(directory):\n    directory = Path(directory)\n    records = []\n    for p in sorted(directory.rglob(\"*\")):\n        if p.is_file():\n            records.append({\"path\": str(p.relative_to(directory)), \"bytes\": p.stat().st_size, \"sha256\": sha256_file(p)})\n    return records\n\nmanifest = {\n    \"experiment\": \"FORGE-AR five-arm end-to-end official patch pass-rate evaluation\",\n    \"run_id\": RUN_ID,\n    \"active_run_root\": str(ACTIVE_RUN_ROOT),\n    \"timestamp_utc\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n    \"seed\": EVAL_SEED,\n    \"task_count_in_source\": len(all_task_ids),\n    \"selected_task_ids\": selected_task_ids,\n    \"budgets\": {\"max_tool_calls\": MAX_TOOL_CALLS, \"max_time_minutes\": MAX_TIME_MINUTES,\n                \"timeout_seconds\": TIMEOUT_SECONDS, \"verification_timeout_seconds\": VERIFY_TIMEOUT_SECONDS,\n                \"concurrency\": CONCURRENCY, \"sandbox\": SANDBOX, \"max_turns_env\": CFG[\"SUB_BUDGET\"].get(\"turns\", 500)},\n    \"paths\": {\"tasks\": str(TASKS_PATH), \"snapshots\": str(SNAPSHOTS_DIR), \"eval_root\": str(EVAL_ROOT)},\n    \"arms\": {name: {\"submission_dir\": str(path), \"submission_files\": hash_tree(path), \"results_dir\": str(run_dirs[name])} for name, path in submission_arms},\n    \"summary\": summaries,\n    \"arm_hashes\": {name: tree_digest(path) for name, path in submission_arms},\n    \"run_status\": {name: load_json(Path(run_dirs[name]) / \"run_status.json\") for name in run_dirs},\n}\n(EVAL_ROOT / \"experiment_manifest.json\").write_text(json.dumps(manifest, indent=2, default=str))\nprint(\"Saved report files:\")\nfor p in sorted(EVAL_ROOT.rglob(\"*\")):\n    if p.is_file(): print(\" -\", p.relative_to(EVAL_ROOT), f\"({p.stat().st_size:,} bytes)\")\nprint(\"\\nHeadline table:\")\ndisplay(summary_df)\nprint(\"\\nInterpretation guardrails:\")\nprint(\"- Use official harness resolution_rate as the primary metric.\")\nprint(\"- Compare only arms evaluated on the same task IDs and budgets.\")\nprint(\"- A small screening subset is preliminary; do not present it as a full competition score.\")\nprint(\"- If metrics are missing, inspect raw summaries and task_results before interpreting.\")\n","metadata":{"execution":{"execution_failed":"2026-10-27T18:04:06.343Z"},"trusted":true},"outputs":[],"execution_count":null},{"id":"9eb82cc1-6c41-4e23-a197-07191b44e86f","cell_type":"markdown","source":"## 11. Troubleshooting and GPU notes\n\n- **Fewer than four GPUs visible:** enable the Kaggle 4×L4 accelerator/runtime for this competition and restart the session. Do not manually set `CUDA_VISIBLE_DEVICES` to a single device.\n- **Low GPU utilization:** the offline localization/ranking sections are CPU-bound by design. GPU utilization should rise when `swegemma` starts its model inference server; check each arm's `gpu_telemetry.json` and harness logs.\n- **`swegemma` not found:** complete the competition's documented environment setup; this notebook deliberately does not install unknown harness wheels.\n- **Docker/sandbox error:** confirm the runtime supports Docker and use the competition-required sandbox setting.\n- **Missing tasks/snapshots:** inspect `/kaggle/input` and update `FORGEX_EVAL_TASKS` / `FORGEX_EVAL_SNAPSHOTS`.\n- **Missing generated config:** rerun the submission-builder cell in section 8.\n- **Generated arm missing:** rerun the submission-builder cell in section 8; section 10 requires all four generated arms to exist and be distinct.\n- **Blank summary fields:** inspect `summary.json`, `task_results.jsonl`, and `stdout.log`; the parser does not guess unknown schema fields.\n- **Full run too long:** set `FORGEX_RUN_MODE=screen` or `FORGEX_EVAL_N_TASKS=20` for a screening run. For a full benchmark, keep `FORGEX_RUN_MODE=full` and `FORGEX_EVAL_N_TASKS=none`.\n- **Concurrency tuning:** default is 2, matching the documented harness example. Raise it only if the host and sandbox limits allow it; four-GPU tensor parallelism is model-level, not one GPU per task.\n- **Important distinction:** GPU use comes from the harness-managed vLLM server. This notebook records hardware status and GPU telemetry but does not independently force undocumented vLLM flags. The stated tensor-parallel/memory/context settings are from the competition README and should be verified in the harness's inference logs.\n","metadata":{}},{"id":"c6562e95-7707-4e6b-9b44-d7355eb773c2","cell_type":"markdown","source":"## 12. Final decision gate — do not overclaim\n\nBefore describing the controller as improving bug resolution, verify all of the following:\n\n1. The official harness exited with code 0 for E2 and E4 and neither run has a detected infrastructure failure.\n2. Each primary arm has exactly one recognized outcome for every selected task ID; no missing, duplicate, unexpected, or unknown outcomes exist.\n3. E2 and E4 used identical task IDs, model/runtime, sandbox, budgets, and concurrency. Their prompt hashes must differ only by the intended controller-policy addition.\n4. The primary result comes from the paired official task outcomes, not localization MRR, prompt hashes, helper self-tests, or row counts.\n5. Report E2 and E4 resolution rates, absolute difference, 95% paired bootstrap interval, controller wins/losses/ties, exact McNemar p-value, elapsed time, and infrastructure-failure counts.\n6. Treat a five-task screen as a smoke test, not general evidence. A positive screen result must be followed by a larger run and, if feasible, the complete task set.\n7. Preserve the selected task IDs, prompt hashes, run status, raw logs, raw task results, and experiment manifest.\n8. If any validity check fails, the claim status must remain **BLOCKED**. Infrastructure failures are neither bug-fix failures nor evidence for/against the controller.\n9. The prompt describes an intended policy, not an independently instrumented runtime controller. Unless harness traces prove the ledger was followed, call this a *failure-driven controller prompt ablation*, not a measured external controller implementation.\n\nOnly state that the controller improves resolution if the validated paired evidence supports that claim. Otherwise report the effect as inconclusive or negative.\n","metadata":{}}]}