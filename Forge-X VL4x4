wn","source":"## 7. Figures","metadata":{}},{"id":"8eca2d26","cell_type":"code","source":"import matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(9.5, 4.2))\nnames = list(SYSROWS)\nmrr = [forgex.mean_rows(SYSROWS[n], [\"unit/mrr\"])[\"unit/mrr\"] for n in names]\ncis = [boot_ci([r[\"unit/mrr\"] for r in SYSROWS[n] if \"unit/mrr\" in r]) for n in names]\nax.bar(range(len(names)), mrr, yerr=[[m - c[0] for m, c in zip(mrr, cis)], [c[1] - m for m, c in zip(mrr, cis)]], capsize=3)\nax.set_xticks(range(len(names))); ax.set_xticklabels([n.split(\" \")[0] if n[0] == \"A\" else \"graph\" for n in names])\nax.set_ylabel(\"unit MRR (95% bootstrap CI)\"); ax.set_title(\"Contribution A: each step adds one thing\")\nfig.tight_layout(); fig.savefig(CFG[\"OUT\"] / \"localization_chain.png\", dpi=140); plt.show()\n\nfig, ax = plt.subplots(figsize=(7, 4))\nfor K in CFG[\"GRAPH_KS\"]:\n    s = sens[sens.K == K]\n    ax.plot(s.beta, s[\"unit/mrr\"], marker=\"o\", label=f\"K={K}\")\nax.axhline(base[\"unit/mrr\"], color=\"gray\", ls=\"--\", label=\"no graph (A5)\")\nax.set_xlabel(\"graph weight beta\"); ax.set_ylabel(\"unit MRR\"); ax.legend(); ax.set_title(\"Graph weight: helps a little, hurts when large\")\nfig.tight_layout(); fig.savefig(CFG[\"OUT\"] / \"graph_sensitivity.png\", dpi=140); plt.show()\n\nfig, ax = plt.subplots(figsize=(7.5, 4))\nax.bar(range(len(pols)), [nav_df.loc[p, \"hit@12 calls\"] for p in pols]); ax.set_xticks(range(len(pols)))\nax.set_xticklabels(pols, rotation=30, ha=\"right\"); ax.set_ylabel(\"hit@12 calls\"); ax.set_ylim(0, 1)\nax.set_title(\"Contribution C: no policy beats reading the ranking\")\nfig.tight_layout(); fig.savefig(CFG[\"OUT\"] / \"navigation.png\", dpi=140); plt.show()","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:33:28.853241Z","iopub.execute_input":"2026-10-27T17:33:28.853449Z","iopub.status.idle":"2026-10-27T17:33:30.817232Z","shell.execute_reply.started":"2026-10-27T17:33:28.853431Z","shell.execute_reply":"2026-10-27T17:33:30.816701Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 950x420 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x400 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 750x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":16},{"id":"c789f6d5","cell_type":"markdown","source":"## 8. Save results and build the FORGE-X v3 submission\nThis creates the candidate agent configuration. The localization study does **not** establish that it improves issue resolution; the official evaluation cells added below test that directly. The v3 prompt includes a template-boilerplate instruction, which should be treated as an experimental change rather than a proven improvement.","metadata":{}},{"id":"211b25a4","cell_type":"code","source":"manifest = dict(project=\"FORGE-AR (FORGE-X + failure-driven adaptive control)\", competition=\"gemma-4-developer-agent\", model=CFG[\"MODEL_ID\"], n_tasks=len(RES), seed=SEED,\n                repos=repos, systems=list(ALL_SYS), query_variants=list(QV), graph_choice_by_heldout_repo=picks,\n                versions=dict(python=platform.python_version()),\n                config={k: (str(v) if isinstance(v, Path) else v) for k, v in CFG.items()},\n                timestamp=time.strftime(\"%Y-%m-%d %H:%M:%S\"))\n(CFG[\"OUT\"] / \"run_manifest.json\").write_text(json.dumps(manifest, indent=1, default=str))\nprint(\"saved:\", sorted(p.name for p in CFG[\"OUT\"].iterdir()))","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:33:30.817935Z","iopub.execute_input":"2026-10-27T17:33:30.818153Z","iopub.status.idle":"2026-10-27T17:33:30.823667Z","shell.execute_reply.started":"2026-10-27T17:33:30.818119Z","shell.execute_reply":"2026-10-27T17:33:30.823186Z"},"trusted":true},"outputs":[{"name":"stdout","text":"saved: ['gpu_preflight.json', 'graph_sensitivity.csv', 'graph_sensitivity.png', 'localization_chain.png', 'localization_deltas.csv', 'localization_table.csv', 'navigation.png', 'navigation_deltas.csv', 'navigation_table.csv', 'phase1_rows_v3.pkl', 'run_manifest.json', 'sensitivity_deltas.csv']\n","output_type":"stream"}],"execution_count":17},{"id":"01fa7b9b","cell_type":"code","source":"# FORGE-AR implementation: deterministic failure diagnosis, action utility, and unit tests.\n# These helpers are for reproducible policy analysis; the deployed agent follows the corresponding\n# policy in SYSTEM_MD because the competition harness controls tool execution.\nimport re, math, json, time\nfrom pathlib import Path\n\nFAILURE_RULES = [\n    (\"environment\", re.compile(r\"network is unreachable|temporary failure in name resolution|cuda out of memory|no such file or directory.*(workspace|repo)\", re.I)),\n    (\"syntax_import\", re.compile(r\"syntaxerror|indentationerror|modulenotfounderror|importerror|cannot import name\", re.I)),\n    (\"test_assertion\", re.compile(r\"assertionerror|failed asserting|expected .* but got|tests? failed\", re.I)),\n    (\"regression\", re.compile(r\"previously passing|regression|new failure|test suite.*now fails\", re.I)),\n    (\"wrong_location\", re.compile(r\"file not found|symbol not found|no matches|empty search results|wrong file\", re.I)),\n    (\"patch_rejected\", re.compile(r\"patch failed|hunk failed|invalid patch|edit conflict\", re.I)),\n]\nFAILURE_ACTIONS = {\n    \"environment\": [\"inspect_environment\", \"retry_once_if_transient\", \"stop_if_blocked\"],\n    \"syntax_import\": [\"inspect_traceback_and_imports\", \"make_minimal_syntax_or_import_patch\", \"run_focused_test\"],\n    \"test_assertion\": [\"map_assertion_to_code_path\", \"inspect_related_symbol_and_test\", \"revise_minimal_patch\"],\n    \"regression\": [\"revert_last_patch_or_restore_checkpoint\", \"compare_failing_tests\", \"apply_smaller_patch\"],\n    \"wrong_location\": [\"expand_bm25_and_identifier_search\", \"inspect_ast_imports_and_callers\", \"update_localization\"],\n    \"patch_rejected\": [\"read_exact_file_range\", \"rebuild_small_patch\", \"verify_diff\"],\n    \"unknown\": [\"inspect_last_tool_result\", \"form_explicit_hypothesis\", \"choose_low_cost_discriminating_test\"],\n}\ndef classify_failure(text):\n    text = str(text or \"\")\n    for label, pattern in FAILURE_RULES:\n        if pattern.search(text):\n            return label\n    return \"unknown\"\n\ndef action_utility(p_progress, value=1.0, cost=1.0, risk=0.0, lam=1.0):\n    \"\"\"Transparent heuristic utility; estimates must be calibrated before scientific claims.\"\"\"\n    p = min(1.0, max(0.0, float(p_progress)))\n    c = max(1e-9, float(cost))\n    r = max(0.0, float(risk))\n    return p * max(0.0, float(value)) / (c + float(lam) * r)\n\ndef choose_action(candidates, lam=1.0):\n    \"\"\"Candidate rows: {action,p_progress,value,cost,risk}; stable tie-break by action name.\"\"\"\n    if not candidates:\n        raise ValueError(\"at least one candidate action is required\")\n    scored = [(action_utility(x.get(\"p_progress\", .25), x.get(\"value\", 1),\n                              x.get(\"cost\", 1), x.get(\"risk\", 0), lam),\n               str(x[\"action\"]), x) for x in candidates]\n    scored.sort(key=lambda z: (-z[0], z[1]))\n    return {\"utility\": scored[0][0], **scored[0][2]}\n\ndef make_attempt_record(task_id, attempt, action, failure_text=\"\", cost=None, outcome=None):\n    return {\"task_id\": str(task_id), \"attempt\": int(attempt), \"action\": str(action),\n            \"failure_class\": classify_failure(failure_text) if failure_text else None,\n            \"failure_excerpt\": str(failure_text)[:500], \"cost\": cost or {},\n            \"outcome\": outcome, \"timestamp_utc\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())}\n\n# Fail-fast deterministic self-tests.\nassert classify_failure(\"ModuleNotFoundError: No module named x\") == \"syntax_import\"\nassert classify_failure(\"AssertionError: expected 2 but got 3\") == \"test_assertion\"\nassert classify_failure(\"patch failed: hunk failed\") == \"patch_rejected\"\nassert classify_failure(\"no matches found for symbol\") == \"wrong_location\"\nassert choose_action([{\"action\":\"broad_search\",\"p_progress\":.8,\"cost\":4,\"risk\":.2},\n                      {\"action\":\"focused_test\",\"p_progress\":.5,\"cost\":1,\"risk\":.05}])[\"action\"] == \"focused_test\"\nprint(\"FORGE-AR policy self-tests: PASS\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:33:30.824373Z","iopub.execute_input":"2026-10-27T17:33:30.824575Z","iopub.status.idle":"2026-10-27T17:33:30.849162Z","shell.execute_reply.started":"2026-10-27T17:33:30.824557Z","shell.execute_reply":"2026-10-27T17:33:30.848649Z"}},"outputs":[{"name":"stdout","text":"FORGE-AR policy self-tests: PASS\n","output_type":"stream"}],"execution_count":18},{"id":"41951ec6","cell_type":"code","source":"MODEL = CFG[\"MODEL_ID\"]; B = CFG[\"SUB_BUDGET\"]\nGRAPH_TOOLS = [\"get_code_neighbors\", \"search_similar_code\", \"get_code_subgraph\"]\nBASE_TOOLS = [\"run_command\", \"read_file\", \"edit_file\", \"write_file\", \"get_status\", \"submit_patch\"]\n\nSYSTEM_MD = \"\"\"You are an expert autonomous software engineer fixing an issue in the repository at /workspace.\n\n## Goal\nMake the smallest correct change to SOURCE code so the behaviour described in the issue is fixed. A hidden test suite checks your patch.\n\n## How to work\n0. The task text may be a pull-request description with template boilerplate (checklists, comments, disclaimers). Ignore that and focus on the title and the description of the change.\n1. Localize first. Use identifiers from the issue (backticked names, classes, functions) as queries: call `search_similar_code` with a symbol name such as `Class.method` (it takes symbol names, not sentences), then `get_code_neighbors` on the best match to see callers and callees. You may delegate localization to the code_analyzer tool, which returns a short report.\n2. Read narrowly: use read_file with line ranges around the symbol you need.\n3. Edit in small steps: one logical change per edit_file call. Never paste whole files.\n4. Verify cheaply: run only the test file(s) that cover the code you changed (for example `pytest tests/test_x.py -k name -x -q`). Never run the whole suite. If a test fails, compare against the pre-edit baseline and gather evidence before classifying it as unrelated; never ignore a failure without documenting why.\n5. Keep scratch scripts in /tmp, not in /workspace. Never edit tests, conftest.py, pytest.ini, pyproject.toml, tox.ini or setup.cfg (those changes are discarded).\n5b. Budget: call get_status after every 4th tool call. When tool_calls_remaining is 5 or less, stop broad exploration, make the best evidence-supported minimal edit, run the cheapest relevant check if possible, inspect the diff, and submit.\n6. Finish: check that `git status` shows only intended source changes, call submit_patch (it is free), then give a one-line summary.\n\n## Rules\n- Follow exact error messages, exception types, status codes and signatures stated in the issue.\n- Do not refactor or reformat unrelated code.\n- Never end without a non-empty source patch.\n\"\"\"\nFORGEX_SYSTEM_MD = SYSTEM_MD\nSYSTEM_MD = SYSTEM_MD + '\\n## Failure-driven adaptive control (FORGE-AR)\\nMaintain a concise attempt ledger: hypothesis, evidence inspected, action, result, cost, and next step. After every failed test, syntax/import error, rejected patch, or unsuccessful localization, classify the failure before acting:\\n- wrong location / no useful matches: broaden BM25 terms, extract issue identifiers, inspect AST symbols, imports, callers/callees, and relevant tests; do not keep reading the same file.\\n- missing symbol / import error: inspect definitions, import aliases, package exports, and dependency/version context before editing.\\n- syntax error / patch rejected: inspect the exact diff and affected lines, repair only the malformed hunk, then run a syntax or focused test check.\\n- failing assertion: map expected-versus-actual behavior to the smallest relevant code path; state a falsifiable root-cause hypothesis before editing.\\n- regression: stop feature work, compare the new failures with the pre-patch baseline, revert the last risky change or restore the checkpoint, and re-apply a smaller patch.\\n- environment failure: distinguish infrastructure/network/resource failure from a code defect; retry transient failures at most once and do not claim a code fix.\\nUse evidence fusion rather than a fixed file ranking: combine lexical/BM25 relevance, exact identifiers, AST unit and parent/child structure, import relations, call neighbors, test-file evidence, and runtime error text. Reweight evidence according to the latest failure; test evidence and traceback frames should dominate after a concrete assertion/exception.\\nUse hypothesis-driven minimal patches. Preserve the pre-edit state (or use git diff/checkpoint), edit one logical change at a time, inspect the diff, run the narrowest discriminating test, and then run a relevant regression subset. Never edit tests/configuration merely to make the run pass. Submit only a non-empty, intended source patch.\\nBudget-aware policy: before each expensive action, estimate probability of progress, value, cost, and regression risk. Prefer the action maximizing U(a)=P(progress|history)*value/(cost+lambda*risk). Use conservative, transparent estimates; avoid repeating an action that failed without new evidence. Keep hard limits on tool calls, wall time, retries per failure class, and repeated identical actions. Stop when verified, when the budget is exhausted, or when only environment blockers remain. Report unresolved uncertainty honestly.\\n'\n\nANALYZER_MD = \"\"\"You are a read-only code analysis sub-agent. Find where the reported issue lives; do not edit anything.\n\n1. Take identifiers from the issue (class, function, argument and message names) and locate them: call `search_similar_code` with a symbol name such as `Class.method`, then `get_code_neighbors` on the best match to see callers and callees.\n2. Read only the lines you need (read_file allows 150 lines per call).\n3. Reply in at most 150 words, no code blocks: file:line to change, the root cause in one or two sentences, and the smallest change that fixes it.\n\"\"\"\nSUB = CFG[\"SUBMISSION_DIR\"]\nshutil.rmtree(SUB, ignore_errors=True)\nfor d in (\"prompts\", \"configs\", \"sub_agents\"):\n    (SUB / d).mkdir(parents=True)\n(SUB / \"prompts/system.md\").write_text(SYSTEM_MD)\n(SUB / \"prompts/analyzer.md\").write_text(ANALYZER_MD)\nsampling_yaml = \"temperature: 0.2\\ntop_p: 0.95\\nmax_output_tokens: 16384\\nthinking_config:\\n  include_thoughts: true\\n  thinking_budget: 4096\\n\"\n(SUB / \"configs/sampling.yaml\").write_text(sampling_yaml)\n# The submission compiler blocks '..' in !include paths. Keep sub-agent includes local.\n(SUB / \"sub_agents/analyzer.md\").write_text(ANALYZER_MD)\n(SUB / \"sub_agents/sampling.yaml\").write_text(sampling_yaml)\n(SUB / \"eval_config.yaml\").write_text(f\"evaluation:\\n  timeout_seconds: {B['cmd_timeout']}\\n  max_tool_calls: {B['calls']}\\n  max_time_minutes: {B['minutes']}\\n  max_turns: {B['turns']}\\n\")\n(SUB / \"sub_agents/code_analyzer.yaml\").write_text(\n    f\"name: code_analyzer_agent\\ndescription: Analyzes repository source files and symbol graphs to locate root causes.\\nmodel: {MODEL}\\n\"\n    \"instruction: !include analyzer.md\\ntools:\\n\" + \"\".join(f\"  - {t}\\n\" for t in [\"read_file\"] + GRAPH_TOOLS) +\n    \"generate_content_config: !include sampling.yaml\\n\")\n(SUB / \"agent.yaml\").write_text(\n    f\"name: forgex_v3\\nmodel: {MODEL}\\ninstruction: !include prompts/system.md\\ntools:\\n\" + \"\".join(f\"  - {t}\\n\" for t in BASE_TOOLS + GRAPH_TOOLS) +\n    \"  - agent_tool:\\n      config_path: sub_agents/code_analyzer.yaml\\n      skip_summarization: true\\n\"\n    \"generate_content_config: !include configs/sampling.yaml\\n\")\n\n# ---- offline structural validation (rules from HARNESS_README.md; not a substitute for the official validator) ----\nALLOWED_EXT = {\".yaml\", \".yml\", \".md\", \".txt\", \".py\", \".json\", \".safetensors\"}\ndef validate_submission(d):\n    d, errs = Path(d).resolve(), []\n    roots = [p for p in (\"agent.yaml\", \"agent.yml\", \"root_agent.yaml\", \"root_agent.yml\") if (d / p).exists()]\n    if len(roots) != 1:\n        errs.append(f\"need exactly one root config, found {roots}\")\n    models, adapters = set(), set()\n    for p in d.rglob(\"*\"):\n        if p.is_symlink():\n            errs.append(f\"symlink: {p}\")\n        if p.is_file() and p.suffix.lower() not in ALLOWED_EXT:\n            errs.append(f\"extension not allowed: {p.name}\")\n    for y in list(d.rglob(\"*.yaml\")):\n        txt = y.read_text()\n        models |= {m.group(1).split(\"/\")[-1] for m in re.finditer(r\"^\\s*model:\\s*(\\S+)\", txt, re.M)}\n        adapters |= {m.group(1) for m in re.finditer(r\"^\\s*adapter:\\s*(\\S+)\", txt, re.M)}\n        for m in re.finditer(r\"!include\\s+(\\S+)\", txt):\n            tgt = (y.parent / m.group(1)).resolve()\n            if d not in tgt.parents or not tgt.exists():\n                errs.append(f\"{y.name}: bad include {m.group(1)}\")\n        for m in re.finditer(r\"config_path:\\s*(\\S+)\", txt):\n            if not (d / m.group(1)).exists():\n                errs.append(f\"{y.name}: config_path missing {m.group(1)}\")\n    if models != {MODEL}:\n        errs.append(f\"expected exactly one base model {MODEL}, found {sorted(models)}\")\n    for a in adapters:\n        if not ((d / \"adapters\" / a / \"adapter_config.json\").exists() and (d / \"adapters\" / a / \"adapter_model.safetensors\").exists()):\n            errs.append(f\"adapter '{a}' is referenced but its folder is incomplete\")\n    return errs\n\nerrs = validate_submission(SUB)\nprint(\"validation:\", \"OK\" if not errs else errs)\nif not errs:\n    zp = shutil.make_archive(str(SUB.parent / \"submission\"), \"zip\", root_dir=SUB)\n    print(\"submission:\", zp, f\"({Path(zp).stat().st_size / 1e3:.1f} KB)\")\n    print(sorted(str(p.relative_to(SUB)) for p in SUB.rglob(\"*\") if p.is_file()))\n\n# Build matched prompt ablation arms for E2-E5. All use the same tools/model/budget.\n# These are prompt-policy ablations; they do not change the underlying model or harness.\n\n# Matched prompt-policy arms. The only intended arm-level intervention is the prompt text.\n# E2 is the no-controller reference; E3 adds localization only; E4 adds controller only;\n# E5 combines both. The base prompt is frozen before either intervention is appended.\nFORGE_AR_POLICY = SYSTEM_MD[len(FORGEX_SYSTEM_MD):]\nLOCALIZATION_POLICY = \"\"\"\n## Evidence-fusion localization policy (localization ablation)\nUse a deliberate evidence sequence: (1) exact identifiers and issue terms; (2) lexical/BM25 matches;\n(3) AST symbol, parent/child, and file hierarchy; (4) imports and caller/callee neighbors;\n(5) related tests; (6) traceback and runtime evidence. Do not assume every signal is available.\nRecord the strongest evidence for the chosen code location and why alternatives were rejected.\nWhen a concrete test failure or traceback exists, prioritize the relevant test assertion and stack frame\nover generic lexical similarity. Keep edits minimal and verify with the narrowest discriminating test.\n\"\"\"\nCONTROLLER_POLICY = \"\"\"\n## Failure-driven adaptive repair controller (controller ablation)\nThis protocol is mandatory after every meaningful search, edit, command, or verification result.\nMaintain a compact attempt ledger in working notes with one row per attempted action and these fields:\nattempt number | current hypothesis | evidence inspected | action taken | observed result |\nfailure class | estimated cost (tool calls/time) | next action and rationale.\nDo not invent results or claim a tool ran unless its output was observed. Update the ledger after each\nresult, not retrospectively at the end. Before choosing the next action, consult the latest ledger entry.\n\nClassify a failed or unproductive action into exactly one primary class:\n- WRONG_LOCATION: no useful match, wrong file, or absent symbol. Change the search query; use exact\n  identifiers, lexical terms, AST hierarchy, imports, callers/callees, and tests. Do not reread the same\n  file without a new question.\n- MISSING_SYMBOL_IMPORT: inspect definitions, aliases, package exports, dependency declarations and\n  version context before editing.\n- SYNTAX_OR_PATCH_REJECTED: inspect the exact changed lines and diff; repair only the malformed hunk,\n  then run a syntax/import check or focused test.\n- ASSERTION_OR_BEHAVIOUR: translate expected-versus-actual output into a falsifiable root-cause\n  hypothesis; trace the assertion to the smallest relevant implementation path before editing.\n- REGRESSION: stop adding features; compare current failures with baseline evidence, inspect the diff,\n  revert the last risky change or narrow it, then rerun the previously passing focused check.\n- ENVIRONMENT_OR_RESOURCE: separate infrastructure/network/resource problems from code defects.\n  Retry a transient failure at most once; if still blocked, preserve logs and do not claim a code fix.\n- NO_PROGRESS: if an action produces no new evidence, do not repeat it unchanged; select a different\n  evidence source or stop if the budget cannot support a meaningful next step.\n\nAction-selection rule: state the next action and the evidence that would change the current hypothesis.\nPrefer the action with the best expected diagnostic or repair value per tool-call/time cost and regression\nrisk. These estimates are qualitative heuristics, not learned probabilities. Never claim they are calibrated.\nLimits: at most two retries for the same failure class, and never repeat the exact same failed action\nunless new evidence changes its expected value. Follow the task's hard tool/time limits; inspect status\nat regular intervals; stop broad exploration near budget exhaustion.\n\nPatch/verification protocol:\n1. State the current root-cause hypothesis before editing.\n2. Make one logical source change at a time; never modify tests/configuration just to make tests pass.\n3. Inspect the diff after every edit and confirm only intended source files changed.\n4. Run the narrowest test that distinguishes the hypothesis. If it fails, classify the failure and update\n   the ledger before deciding what to do next.\n5. After a focused test passes, run a relevant regression subset if budget permits.\n6. Submit a non-empty, intended source patch only after checking status and diff. Report verification\n   status and unresolved uncertainty honestly.\n\nThe ledger is an agent-reasoning protocol expressed in the prompt; the evaluation harness does not expose\na separately instrumented controller API in this notebook. Therefore, prompt compliance is not itself\nproof of execution. End-to-end benefit must be established by paired official task outcomes against the\nmatched no-controller arm.\n\"\"\"\ndef write_prompt_arm(arm_name, prompt):\n    arm_dir = SUB.parent / arm_name\n    shutil.rmtree(arm_dir, ignore_errors=True)\n    shutil.copytree(SUB, arm_dir)\n    (arm_dir / \"prompts\" / \"system.md\").write_text(prompt, encoding=\"utf-8\")\n    return arm_dir\n\nFORGEX_CURRENT_DIR = write_prompt_arm(\"forgex_current\", FORGEX_SYSTEM_MD)\nFORGEX_LOCALIZATION_DIR = write_prompt_arm(\"forgex_localization\", FORGEX_SYSTEM_MD + LOCALIZATION_POLICY)\nFORGEX_CONTROLLER_DIR = write_prompt_arm(\"forgex_controller\", FORGEX_SYSTEM_MD + CONTROLLER_POLICY)\n# SUB itself is the combined arm generated above from SYSTEM_MD = base + localization/controller policy.\n# Re-write the combined prompt explicitly to avoid accidental drift if earlier cells are edited.\n(SUB / \"prompts\" / \"system.md\").write_text(FORGEX_SYSTEM_MD + LOCALIZATION_POLICY + CONTROLLER_POLICY, encoding=\"utf-8\")\n\ndef prompt_text(directory):\n    return (Path(directory) / \"prompts\" / \"system.md\").read_text(encoding=\"utf-8\")\n\nBASE_PROMPT = prompt_text(FORGEX_CURRENT_DIR)\nLOCALIZATION_PROMPT = prompt_text(FORGEX_LOCALIZATION_DIR)\nCONTROLLER_PROMPT = prompt_text(FORGEX_CONTROLLER_DIR)\nCOMBINED_PROMPT = prompt_text(SUB)\nassert BASE_PROMPT == FORGEX_SYSTEM_MD\nassert LOCALIZATION_PROMPT == FORGEX_SYSTEM_MD + LOCALIZATION_POLICY\nassert CONTROLLER_PROMPT == FORGEX_SYSTEM_MD + CONTROLLER_POLICY\nassert COMBINED_PROMPT == FORGEX_SYSTEM_MD + LOCALIZATION_POLICY + CONTROLLER_POLICY\nassert len({hashlib.sha256(x.encode()).hexdigest() for x in\n            [BASE_PROMPT, LOCALIZATION_PROMPT, CONTROLLER_PROMPT, COMBINED_PROMPT]}) == 4\nprint(\"Matched prompt-policy arms built and verified:\")\nprint(json.dumps({\n    \"E2_forgex_no_controller\": {\"dir\": str(FORGEX_CURRENT_DIR), \"prompt_sha256\": hashlib.sha256(BASE_PROMPT.encode()).hexdigest()},\n    \"E3_evidence_localization\": {\"dir\": str(FORGEX_LOCALIZATION_DIR), \"prompt_sha256\": hashlib.sha256(LOCALIZATION_PROMPT.encode()).hexdigest()},\n    \"E4_failure_controller\": {\"dir\": str(FORGEX_CONTROLLER_DIR), \"prompt_sha256\": hashlib.sha256(CONTROLLER_PROMPT.encode()).hexdigest()},\n    \"E5_full_forge_ar\": {\"dir\": str(SUB), \"prompt_sha256\": hashlib.sha256(COMBINED_PROMPT.encode()).hexdigest()},\n}, indent=2))\n","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:33:30.849878Z","iopub.execute_input":"2026-10-27T17:33:30.850067Z","iopub.status.idle":"2026-10-27T17:33:30.88485Z","shell.execute_reply.started":"2026-10-27T17:33:30.85005Z","shell.execute_reply":"2026-10-27T17:33:30.884345Z"},"trusted":true},"outputs":[{"name":"stdout","text":"validation: OK\nsubmission: /kaggle/working/submission.zip (4.8 KB)\n['agent.yaml', 'configs/sampling.yaml', 'eval_config.yaml', 'prompts/analyzer.md', 'prompts/system.md', 'sub_agents/analyzer.md', 'sub_agents/code_analyzer.yaml', 'sub_agents/sampling.yaml']\nMatched prompt-policy arms built and verified:\n{\n  \"E2_forgex_no_controller\": {\n    \"dir\": \"/kaggle/working/forgex_current\",\n    \"prompt_sha256\": \"02d7614b9f36b4f415a117e554399a80dce56b46fe9a218e0fdc8dd400cd1756\"\n  },\n  \"E3_evidence_localization\": {\n    \"dir\": \"/kaggle/working/forgex_localization\",\n    \"prompt_sha256\": \"ef6b0c357187e6851f4557ef64c8158e1ed75b60310cda76c31cb833e6749eed\"\n  },\n  \"E4_failure_controller\": {\n    \"dir\": \"/kaggle/working/forgex_controller\",\n    \"prompt_sha256\": \"74cc359106750a3e7dea515e4c7c3f40c22b1cbeb8839a65ef0c5fcf26e0f919\"\n  },\n  \"E5_full_forge_ar\": {\n    \"dir\": \"/kaggle/working/forgex_v3_submission\",\n    \"prompt_sha256\": \"2a8f846f71c87d588c858021aaf2f82707932d9de5a34483e76f466109e1f39b\"\n  }\n}\n","output_type":"stream"}],"execution_count":19},{"id":"cb34de5a","cell_type":"markdown","source":"## 9. Next steps and interpretation\n1. Run the official pass-rate comparison below before claiming improvement.\n2. The localization study uses gold patches on available snapshots and is an offline diagnostic; it is not a competition pass rate.\n3. Treat query cleaning, graph weighting, and prompt changes as hypotheses until a paired official-harness comparison supports them.\n4. Preserve the manifest, task IDs, harness output, and submission directory for reproducibility.","metadata":{}},{"id":"fbceff64","cell_type":"markdown","source":"## 9.5. Execution order and primary hypothesis test\n\n1. Run cells from the top to regenerate localization metrics, policy unit tests, and all prompt-policy arms.\n2. Validate the arm prompts and generated artifacts. E2 and E4 must share every setting except the controller policy appended to `prompts/system.md`.\n3. Run the official harness in screen mode first. After the sandbox is proven functional, run a larger shared task set and then the full set if resources permit.\n4. **Primary comparison:** `E4_failure_controller` versus `E2_forgex_no_controller`. This isolates the controller prompt. `E3_evidence_localization` versus E2 isolates localization; E5 measures the combination.\n5. These are prompt-policy interventions, not model fine-tuning. The Python failure classifier and utility helper are unit-tested analysis utilities; they are not claimed to be called by the harness as an external runtime controller.\n6. An improvement claim is permitted only if both arms pass the strict run-validity gate, share exactly the same task IDs/model/runtime/sandbox/budgets, and have valid task-level outcomes for all selected tasks.\n7. Report resolution-rate difference, paired wins/losses/ties, a confidence interval, McNemar's exact test, runtime, tool calls if exposed, and infrastructure-failure counts. If validity fails, report the experiment as blocked—not as a 0% performance result.\n","metadata":{}},{"id":"9788cc81-a015-4186-aa11-c1ec90cf5928","cell_type":"markdown","source":"## 10. Configure the official patch pass-rate experiment\n\nThis section evaluates the actual generated agents using `swegemma eval`. It runs the official sample baseline and four generated prompt-policy arms, with E2/E4 as the pre-registered primary comparison. Each arm receives the same selected task IDs and resource limits. The default is a 20-task screening run; after a successful smoke test, set `FORGEX_RUN_MODE=full` or `FORGEX_EVAL_N_TASKS=none` to evaluate all tasks.\n\n**Important:** Do not compare runs with different task IDs, models, or budgets. `resolution_rate` is the official harness resolution metric, not a guarantee of hidden leaderboard performance. Confirm the CLI flags against the competition's installed `swegemma --help` if the local harness version differs.\n","metadata":{}},{"id":"653585bb-7ffe-494e-bd9e-f699c5e5c553","cell_type":"markdown","source":"## Install the competition harness (single controlled install)\\n\\nUse the following installer cell once. The three legacy `!pip install` cells were redundant and could resolve dependencies from the network.","metadata":{"execution":{"iopub.execute_input":"2026-10-19T04:34:53.827953Z","iopub.status.busy":"2026-10-19T04:34:53.827744Z","iopub.status.idle":"2026-10-19T04:38:14.615513Z","shell.execute_reply":"2026-10-19T04:38:14.614859Z","shell.execute_reply.started":"2026-10-19T04:34:53.827935Z"}}},{"id":"b2957b9a-754a-44cc-9f51-15fcec22c64d","cell_type":"code","source":"# Controlled offline installation of the competition-provided harness wheels.\n# Run once per fresh kernel. This deliberately does not upgrade torch/transformers.\nimport sys\nimport subprocess\nfrom pathlib import Path\nimport importlib.util\nfrom importlib import metadata as importlib_metadata\n\nWHEELHOUSE = Path(\"/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse\")\ndef _find_wheel(prefix):\n    hits = sorted(WHEELHOUSE.glob(f\"{prefix}-*.whl\"))\n    return hits[-1].name if hits else None\n\nWHEEL_NAMES = [n for n in (_find_wheel(\"swegemma\"), _find_wheel(\"adk_eval_core\"), _find_wheel(\"adk_submission\")) if n]\nprint(\"Python:\", sys.version)\nprint(\"Interpreter:\", sys.executable)\nprint(\"Wheelhouse exists:\", WHEELHOUSE.is_dir())\n\nmissing = [p for p in (\"swegemma\", \"adk_eval_core\", \"adk_submission\") if _find_wheel(p) is None]\nif missing:\n    raise FileNotFoundError(\n        \"Required competition wheel(s) missing: \" + \", \".join(missing)\n        + f\". Inspect the attached wheelhouse at {WHEELHOUSE}.\"\n    )\n\n# All three selected wheels are expected to be pure-Python wheels. If a wheel is\n# replaced with a platform-specific build, stop instead of installing an ABI mismatch.\nfor name in WHEEL_NAMES:\n    if name.startswith(\"swegemma-\") and not name.endswith(\"-py3-none-any.whl\"):\n        raise RuntimeError(f\"Unexpected swegemma wheel tag: {name}\")\n\nfor name in WHEEL_NAMES:\n    wheel = WHEELHOUSE / name\n    cmd = [sys.executable, \"-m\", \"pip\", \"install\", \"--no-index\", \"--no-deps\", str(wheel)]\n    result = subprocess.run(cmd, capture_output=True, text=True, timeout=180)\n    print(f\"\\nINSTALL {name}: exit={result.returncode}\")\n    print(result.stdout[-2500:])\n    if result.stderr:\n        print(result.stderr[-2500:])\n    if result.returncode != 0:\n        raise RuntimeError(f\"Offline install failed for {name}; see output above.\")\n\n# Verify Python modules with the same interpreter/kernel.\nfor module in (\"swegemma\", \"adk_eval_core\"):\n    spec = importlib.util.find_spec(module)\n    print(f\"{module}: {spec.origin if spec else 'NOT IMPORTABLE'}\")\n    if spec is None:\n        raise RuntimeError(f\"Installed wheel but module {module!r} is not importable. Check competition version requirements.\")\n\nfor distribution in (\"swegemma\", \"adk-eval-core\", \"adk-submission\"):\n    try:\n        print(f\"Distribution {distribution}: {importlib_metadata.version(distribution)}\")\n    except importlib_metadata.PackageNotFoundError:\n        print(f\"Distribution {distribution}: not found under this normalized name; verify wheel metadata if needed\")\n\ncli = subprocess.run([sys.executable, \"-m\", \"pip\", \"show\", \"swegemma\"], capture_output=True, text=True, timeout=30)\nprint(cli.stdout)\nimport os, shutil\nos.environ[\"PATH\"] = str(Path(sys.executable).parent) + os.pathsep + os.environ.get(\"PATH\", \"\")\nSWEGEMMA_BIN = shutil.which(\"swegemma\")\nprint(\"CLI on PATH:\", SWEGEMMA_BIN or \"NOT FOUND\")\nif not SWEGEMMA_BIN:\n    raise RuntimeError(\"swegemma was installed but its CLI is not on PATH. Inspect the distribution entry point and Kaggle PATH.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-10-27T17:33:30.885599Z","iopub.execute_input":"2026-10-27T17:33:30.885788Z","iopub.status.idle":"2026-10-27T17:33:38.012268Z","shell.execute_reply.started":"2026-10-27T17:33:30.885771Z","shell.execute_reply":"2026-10-27T17:33:38.011723Z"},"trusted":true},"ou