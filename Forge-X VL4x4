_EVAL_MAX_TOOL_CALLS\", str(min(CFG[\"SUB_BUDGET\"][\"calls\"], 30) if RUN_MODE == \"screen\" else CFG[\"SUB_BUDGET\"][\"calls\"])))\nMAX_TIME_MINUTES = int(os.environ.get(\"FORGEX_EVAL_MAX_TIME_MINUTES\", str(min(CFG[\"SUB_BUDGET\"][\"minutes\"], 15) if RUN_MODE == \"screen\" else CFG[\"SUB_BUDGET\"][\"minutes\"])))\nTIMEOUT_SECONDS = int(os.environ.get(\"FORGEX_EVAL_TIMEOUT_SECONDS\", str(CFG[\"SUB_BUDGET\"][\"cmd_timeout\"])))\nVERIFY_TIMEOUT_SECONDS = int(os.environ.get(\"FORGEX_EVAL_VERIFY_TIMEOUT_SECONDS\", str(CFG[\"SUB_BUDGET\"][\"cmd_timeout\"])))\nCONCURRENCY = int(os.environ.get(\"FORGEX_EVAL_CONCURRENCY\", \"1\"))  # conservative first-run default\nSANDBOX = os.environ.get(\"FORGEX_EVAL_SANDBOX\", \"docker\")\n\nfor label, p in [(\"tasks\", TASKS_PATH), (\"snapshots\", SNAPSHOTS_DIR), (\"official baseline\", SAMPLE_SUBMISSION_DIR), (\"v3 submission\", V3_SUBMISSION_DIR)]:\n    print(f\"{label:18s}: {p} | exists={p.exists()}\")\nassert TASKS_PATH.is_file(), f\"Missing tasks file: {TASKS_PATH}\"\nassert SNAPSHOTS_DIR.is_dir(), f\"Missing snapshots directory: {SNAPSHOTS_DIR}\"\nassert SAMPLE_SUBMISSION_DIR.is_dir(), f\"Missing official sample submission: {SAMPLE_SUBMISSION_DIR}\"\nassert V3_SUBMISSION_DIR.is_dir(), f\"Missing generated v3 submission: {V3_SUBMISSION_DIR}. Run the submission-builder cell above.\"\nassert CONCURRENCY >= 1, \"FORGEX_EVAL_CONCURRENCY must be >= 1\"\nassert MAX_TOOL_CALLS >= 1 and MAX_TIME_MINUTES >= 1, \"Evaluation budgets must be positive\"\nassert TIMEOUT_SECONDS >= 1 and VERIFY_TIMEOUT_SECONDS >= 1, \"Timeouts must be positive\"\nassert RUN_MODE in {\"screen\", \"full\"}, f\"Unsupported FORGEX_RUN_MODE={RUN_MODE!r}; use screen or full\"\n\nimport shutil\nos.environ[\"PATH\"] = str(Path(sys.executable).parent) + os.pathsep + os.environ.get(\"PATH\", \"\")\nSWEGEMMA = shutil.which(\"swegemma\")\nif not SWEGEMMA:\n    raise RuntimeError(\"swegemma CLI is not on PATH. Run the installer cell above (section 10) or set up the compet